#: virtinst/storage.py:415
#, python-format
msgid "Could not start storage pool: %s"
msgstr "ບໍ່ສາມາດເລີ່ມ storage pool: %s"

#: virtinst/storage.py:421
#, python-format
msgid "Could not set pool autostart flag: %s"
msgstr "ບໍ່ສາມາດຕັ້ງຄ່າ pool ໃຫ້ເລີ່ມອັດຕະໂນມັດ (autostart): %s"

#: virtinst/storage.py:570
#, python-format
msgid "Name '%s' already in use by another volume."
msgstr "ຊື່ '%s' ຖືກໃຊ້ງານຢູ່ແລ້ວໂດຍ volume ອື່ນ."

#: virtinst/storage.py:662
msgid ""
"Sparse logical volumes are not supported, setting allocation equal to "
"capacity"
msgstr ""
"ບໍ່ຮອງຮັບ Sparse logical volumes, ຈະຕັ້ງຄ່າການຈອງພື້ນທີ່ (allocation) ໃຫ້ເທົ່າກັບຄວາມຈຸ "
"(capacity)"

#: virtinst/storage.py:714
#, python-format
msgid "Allocating '%(filename)s'"
msgstr "ກຳລັງຈອງພື້ນທີ່ '%(filename)s'"

#: virtinst/storage.py:755
#, python-format
msgid ""
"There is not enough free space on the storage pool to create the volume. "
"(%(mem1)s M requested allocation > %(mem2)s M available)"
msgstr ""
"ມີພື້ນທີ່ຫວ່າງໃນ storage pool ບໍ່ພຽງພໍທີ່ຈະສ້າງ volume. (ຕ້ອງການຈອງ %(mem1)s M > ແຕ່ມີໃຫ້ໃຊ້ %"
"(mem2)s M)"

#: virtinst/storage.py:762
#, python-format
msgid ""
"The requested volume capacity will exceed the available pool space when the "
"volume is fully allocated. (%(mem1)s M requested capacity > %(mem2)s M "
"available)"
msgstr ""
"ຄວາມຈຸຂອງ volume ທີ່ຕ້ອງການຈະເກີນພື້ນທີ່ pool ທີ່ມີຢູ່ເມື່ອມີການຈອງພື້ນທີ່ເຕັມ. (ຕ້ອງການຄວາມຈຸ %"
"(mem1)s M > ແຕ່ມີໃຫ້ໃຊ້ %(mem2)s M)"

#: virtinst/virtclone.py:20
msgid ""
"An original machine name is required, use '--original src_name' and try "
"again."
msgstr "ຕ້ອງມີຊື່ເຄື່ອງຕົ້ນສະບັບ, ໃຫ້ໃຊ້ '--original src_name' ແລ້ວລອງໃໝ່."

#: virtinst/virtclone.py:66
msgid ""
"Duplicate a virtual machine, changing all the unique host side configuration "
"like MAC address, name, etc. \n"
"\n"
"The VM contents are NOT altered: virt-clone does not change anything "
"_inside_ the guest OS, it only duplicates disks and does host side changes. "
"So things like changing passwords, changing static IP address, etc are "
"outside the scope of this tool. For these types of changes, please see virt-"
"sysprep(1)."
msgstr ""
"ເຮັດສຳເນົາເຄື່ອງສະເໝືອນ, ໂດຍປ່ຽນການຕັ້ງຄ່າສະເພາະດ້ານໂຮສທັງໝົດ ເຊັ່ນ ທີ່ຢູ່ MAC, ຊື່, ແລະ ອື່ນໆ. \n"
"\n"
"ເນື້ອໃນພາຍໃນ VM ຈະບໍ່ຖືກປ່ຽນແປງ: virt-clone ບໍ່ໄດ້ປ່ຽນແປງຫຍັງ \"ພາຍໃນ\" OS ຂອງເກສ, ມັນພຽງ"
"ແຕ່ເຮັດສຳເນົາດິສກ໌ ແລະ ປ່ຽນແປງການຕັ້ງຄ່າດ້ານໂຮສເທົ່ານັ້ນ. ດັ່ງນັ້ນ ສິ່ງຕ່າງໆ ເຊັ່ນ ການປ່ຽນລະຫັດຜ່ານ, ກາ"
"ນປ່ຽນທີ່ຢູ່ IP ແບບຄົງທີ່ ແລະ ອື່ນໆ ແມ່ນຢູ່ນອກຂອບເຂດຂອງເຄື່ອງມືນີ້. ສຳລັບການປ່ຽນແປງປະເພດນັ້ນ, ກະລຸນາເ"
"ບິ່ງ virt-sysprep(1)."

#: virtinst/virtclone.py:77 virtinst/virtinstall.py:1056
msgid "General Options"
msgstr "ຕົວເລືອກທົ່ວໄປ"

#: virtinst/virtclone.py:79
msgid "Name of the original guest to clone."
msgstr "ຊື່ຂອງເກສຕົ້ນສະບັບທີ່ຈະໂຄນ."

#: virtinst/virtclone.py:81
msgid "XML file to use as the original guest."
msgstr "ໄຟລ໌ XML ທີ່ຈະໃຊ້ເປັນເກສຕົ້ນສະບັບ."

#: virtinst/virtclone.py:85
msgid ""
"Auto generate clone name and storage paths from the original guest "
"configuration."
msgstr ""
"ສ້າງຊື່ໂຄນ ແລະ ເສັ້ນທາງບ່ອນເກັບຂໍ້ມູນໂດຍອັດຕະໂນມັດຈາກການຕັ້ງຄ່າຂອງເກສຕົ້ນສະບັບ."

#: virtinst/virtclone.py:87
msgid "Name for the new guest"
msgstr "ຊື່ສຳລັບເກສໃໝ່"

#: virtinst/virtclone.py:89
msgid "use btrfs COW lightweight copy"
msgstr "ໃຊ້ການກັອບປີ້ແບບ btrfs COW lightweight"

#: virtinst/virtclone.py:91
msgid "Storage Configuration"
msgstr "ການຕັ້ງຄ່າບ່ອນເກັບຂໍ້ມູນ"

#: virtinst/virtclone.py:97
msgid "New file to use as the disk image for the new guest"
msgstr "ໄຟລ໌ໃໝ່ທີ່ຈະໃຊ້ເປັນອິມເມຈດິສກ໌ສຳລັບເກສໃໝ່"

#: virtinst/virtclone.py:103
msgid ""
"Force to copy devices (eg, if 'hdc' is a readonly cdrom device, --force-"
"copy=hdc)"
msgstr ""
"ບັງຄັບໃຫ້ກັອບປີ້ອຸປະກອນ (ເຊັ່ນ ຫາກ 'hdc' ເປັນອຸປະກອນ cdrom ທີ່ອ່ານໄດ້ຢ່າງດຽວ, --force-"
"copy=hdc)"

#: virtinst/virtclone.py:109
msgid ""
"Skip copy of the device target. (eg, if 'vda' is a disk you don't want to "
"copy and use the same path in the new VM, use --skip-copy=vda)"
msgstr ""
"ຂ້າມການກັອບປີ້ເປົ້າໝາຍອຸປະກອນ. (ເຊັ່ນ ຫາກ 'vda' ເປັນດິສກ໌ທີ່ທ່ານບໍ່ຕ້ອງການກັອບປີ້ ແລະ ຕ້ອງການໃຊ້ເສັ້ນທ"
"າງເດີມໃນ VM ໃໝ່, ໃຫ້ໃຊ້ --skip-copy=vda)"

#: virtinst/virtclone.py:119
msgid "Do not use a sparse file for the clone's disk image"
msgstr "ບໍ່ຕ້ອງໃຊ້ໄຟລ໌ແບບ sparse ສຳລັບອິມເມຈດິສກ໌ຂອງຕົວໂຄນ"

#: virtinst/virtclone.py:127
msgid ""
"Do not clone storage contents to specified file paths, their contents will "
"be left untouched. This requires specifying existing paths for every "
"cloneable disk image."
msgstr ""
"ບໍ່ຕ້ອງໂຄນເນື້ອໃນບ່ອນເກັບຂໍ້ມູນໄປຍັງເສັ້ນທາງໄຟລ໌ທີ່ກຳນົດ, ເນື້ອໃນຂອງພວກມັນຈະບໍ່ຖືກແຕະຕ້ອງ. ສິ່ງນີ້ຕ້ອງການກ"
"ານກຳນົດເສັ້ນທາງທີ່ມີຢູ່ແລ້ວສຳລັບທຸກໆອິມເມຈດິສກ໌ທີ່ສາມາດໂຄນໄດ້."

#: virtinst/virtclone.py:134
msgid "New file to use as storage for nvram VARS"
msgstr "ໄຟລ໌ໃໝ່ທີ່ຈະໃຊ້ເປັນບ່ອນເກັບຂໍ້ມູນສຳລັບ nvram VARS"

#: virtinst/virtclone.py:137
msgid "Networking Configuration"
msgstr "ການຕັ້ງຄ່າເຄືອຂ່າຍ"

#: virtinst/virtclone.py:143
msgid ""
"New fixed MAC address for the clone guest. Default is a randomly generated "
"MAC"
msgstr ""
"ທີ່ຢູ່ MAC ຄົງທີ່ໃໝ່ສຳລັບເກສທີ່ໂຄນ. ຄ່າເລີ່ມຕົ້ນແມ່ນ MAC ທີ່ສ້າງຂຶ້ນແບບສຸ່ມ"

#: virtinst/virtclone.py:146 virtinst/virtinstall.py:1187
#: virtinst/virtxml.py:567
msgid "Miscellaneous Options"
msgstr "ຕົວເລືອກອື່ນໆ"

#: virtinst/virtclone.py:179
msgid ""
"Either --auto-clone or --file is required, use '--auto-clone or --file' and "
"try again."
msgstr ""
"ຕ້ອງກຳນົດ --auto-clone ຫຼື --file ຢ່າງໃດຢ່າງໜຶ່ງ, ກະລຸນາໃຊ້ '--auto-clone ຫຼື --file' ແລ້ວ"
"ລອງໃໝ່."

#: virtinst/virtclone.py:215
msgid ""
"A name is required for the new virtual machine, use '--name NEW_VM_NAME' to "
"specify one."
msgstr ""
"ຕ້ອງມີຊື່ສຳລັບເຄື່ອງສະເໝືອນໃໝ່, ໃຫ້ໃຊ້ '--name NEW_VM_NAME' ເພື່ອກຳນົດຊື່."

#: virtinst/virtclone.py:234
#, python-format
msgid "Clone '%s' created successfully."
msgstr "ສ້າງຕົວໂຄນ '%s' ສຳເລັດແລ້ວ."

#: virtinst/virtclone.py:245 virtinst/virtinstall.py:1313
msgid "Installation aborted at user request"
msgstr "ການຕິດຕັ້ງຖືກຍົກເລີກຕາມຄຳຮ້ອງຂໍຂອງຜູ້ໃຊ້"

#: virtinst/virtinstall.py:59
msgid ""
"-c specified with what looks like a libvirt URI. Did you mean to use --"
"connect? If not, use --cdrom instead"
msgstr ""
"ມີການລະບຸ -c ດ້ວຍສິ່ງທີ່ເບິ່ງຄືວ່າເປັນ libvirt URI. ທ່ານຕ້ອງການໃຊ້ --connect ແມ່ນບໍ່? ຖ້າບໍ່ແມ່ນ, ໃ"
"ຫ້ໃຊ້ --cdrom ແທນ"

#: virtinst/virtinstall.py:128
msgid "Cannot specify storage and use --nodisks"
msgstr "ບໍ່ສາມາດກຳນົດບ່ອນເກັບຂໍ້ມູນພ້ອມກັບໃຊ້ --nodisks ໄດ້"

#: virtinst/virtinstall.py:133
msgid ""
"Cannot mix --file, --nonsparse, or --file-size with --disk options. Use --"
"disk PATH[,size=SIZE][,sparse=yes|no]"
msgstr ""
"ບໍ່ສາມາດໃຊ້ --file, --nonsparse, ຫຼື --file-size ປະປົນກັບຕົວເລືອກ --disk ໄດ້. ໃຫ້ໃຊ້ --"
"disk PATH[,size=SIZE][,sparse=yes|no] ແທນ"

#: virtinst/virtinstall.py:154
msgid "--os-type is deprecated and does nothing. Please stop using it."
msgstr "--os-type ເຊົາໃຊ້ແລ້ວ ແລະ ບໍ່ມີຜົນຫຍັງ. ກະລຸນາຢຸດໃຊ້ງານມັນ."

#: virtinst/virtinstall.py:229
msgid "Cannot mix --graphics and old style graphical options"
msgstr "ບໍ່ສາມາດໃຊ້ --graphics ປະປົນກັບຕົວເລືອກກຣາຟິກແບບເກົ່າໄດ້"

#: virtinst/virtinstall.py:233
msgid "Can't specify more than one of VNC, SDL, --graphics or --nographics"
msgstr "ບໍ່ສາມາດກຳນົດຫຼາຍກວ່າໜຶ່ງຢ່າງຈາກ VNC, SDL, --graphics ຫຼື --nographics"

#: virtinst/virtinstall.py:315
msgid "--memory amount in MiB is required"
msgstr "ຕ້ອງກຳນົດຈຳນວນ --memory ເປັນ MiB"

#: virtinst/virtinstall.py:318
msgid "--disk storage must be specified (override with --disk none)"
msgstr "ຕ້ອງກຳນົດບ່ອນເກັບຂໍ້ມູນ --disk (ຫຼື ໃຊ້ --disk none ເພື່ອຂ້າມ)"

#: virtinst/virtinstall.py:322
#, python-format
msgid ""
"An install method must be specified\n"
"(%(methods)s)"
msgstr ""
"ຕ້ອງກຳນົດວິທີການຕິດຕັ້ງ\n"
"(%(methods)s)"

#: virtinst/virtinstall.py:336
msgid ""
"CDROM media does not print to the text console by default, so you likely "
"will not see text install output. You might want to use --location."
msgstr ""
"ໂດຍຄ່າເລີ່ມຕົ້ນ ສື່ CDROM ຈະບໍ່ສະແດງຜົນໃນຄອນໂຊລແບບຂໍ້ຄວາມ, ດັ່ງນັ້ນທ່ານອາດຈະບໍ່ເຫັນຜົນການຕິດຕັ້ງແບບຂໍ້ຄ"
"ວາມ. ທ່ານອາດຈະຕ້ອງການໃຊ້ --location."

#: virtinst/virtinstall.py:341
msgid "See the man page for examples of using --location with CDROM media"
msgstr "ເບິ່ງໜ້າ man ສຳລັບຕົວຢ່າງການໃຊ້ --location ກັບສື່ CDROM"

#: virtinst/virtinstall.py:356
#, python-format
msgid ""
"Requested memory %(mem1)s MiB is less than the recommended %(mem2)s MiB for "
"OS %(osname)s"
msgstr ""
"ໜ່ວຍຄວາມຈຳ %(mem1)s MiB ທີ່ທ່ານຂໍນັ້ນໜ້ອຍກວ່າ %(mem2)s MiB ທີ່ແນະນຳສຳລັບ OS %(osname)s"

#: virtinst/virtinstall.py:363
#, python-format
msgid ""
"Requested memory %s MiB is abnormally low. Were you trying to specify GiB?"
msgstr ""
"ໜ່ວຍຄວາມຈຳ %s MiB ທີ່ທ່ານຂໍນັ້ນຕ່ຳຜິດປົກກະຕິ. ທ່ານຕ້ອງການກຳນົດເປັນ GiB ແມ່ນບໍ່?"

#: virtinst/virtinstall.py:380
msgid "The guest's network configuration may not support PXE"
msgstr "ການຕັ້ງຄ່າເຄືອຂ່າຍຂອງເກສອາດຈະບໍ່ຮອງຮັບ PXE"

#: virtinst/virtinstall.py:385
#, python-brace-format
msgid ""
"Using --osinfo {osname}, VM performance may suffer. Specify an accurate OS "
"for optimal results."
msgstr ""
"ການໃຊ້ --osinfo {osname} ອາດເຮັດໃຫ້ປະສິດທິພາບຂອງ VM ຫຼຸດລົງ. ກະລຸນາກຳນົດ OS ທີ່ຖືກຕ້ອງເພື່ອຜົນ"
"ຮັບທີ່ດີທີ່ສຸດ."

#: virtinst/virtinstall.py:401
#, python-brace-format
msgid "Using {osname} --location {url}"
msgstr "ກຳລັງໃຊ້ {osname} --location {url}"

#: virtinst/virtinstall.py:484
#, python-brace-format
msgid "Using default --name {vm_name}"
msgstr "ກຳລັງໃຊ້ຄ່າເລີ່ມຕົ້ນ --name {vm_name}"

#: virtinst/virtinstall.py:495
#, python-brace-format
msgid "Using container default --memory {megabytes}"
msgstr "ກຳລັງໃຊ້ຄ່າເລີ່ມຕົ້ນຂອງ container --memory {megabytes}"

#: virtinst/virtinstall.py:515
#, python-brace-format
msgid "Using {os_name} default --memory {megabytes}"
msgstr "ກຳລັງໃຊ້ຄ່າເລີ່ມຕົ້ນຂອງ {os_name} --memory {megabytes}"

#: virtinst/virtinstall.py:528
#, python-brace-format
msgid "Using {os_name} default --disk {disk_options}"
msgstr "ກຳລັງໃຊ້ຄ່າເລີ່ມຕົ້ນຂອງ {os_name} --disk {disk_options}"

#: virtinst/virtinstall.py:580
#, python-brace-format
msgid ""
"Failed to detect osinfo OS name from install media, using fallback name "
"'{name}'.\n"
"Please file a bug against virt-install if you expected the detection to "
"succeed."
msgstr ""
"ກວດບໍ່ພົບຊື່ OS ຈາກສື່ການຕິດຕັ້ງ, ຈະໃຊ້ຊື່ສຳຮອງ '{name}'.\n"
"ກະລຸນາແຈ້ງບັກ (bug) ໃຫ້ກັບ virt-install ຫາກທ່ານຄິດວ່າການກວດສອບຄວນຈະສຳເລັດ."

#: virtinst/virtinstall.py:587
#, python-format
msgid "Error validating install location: %s"
msgstr "ເກີດຂໍ້ຜິດພາດໃນການກວດສອບຕຳແໜ່ງການຕິດຕັ້ງ: %s"

#: virtinst/virtinstall.py:589
msgid ""
"--osinfo/--os-variant OS name is required, but no value was\n"
"set or detected."
msgstr ""
"ຕ້ອງການຊື່ OS ສຳລັບ --osinfo/--os-variant, ແຕ່ບໍ່ມີການ\n"
"ກຳນົດຄ່າ ຫຼື ກວດບໍ່ພົບຄ່າໃດໆ."

#: virtinst/virtinstall.py:600
msgid ""
"This is now a fatal error. Specifying an OS name is required\n"
"for modern, performant, and secure virtual machine defaults.\n"
msgstr ""
"ນີ້ເປັນຂໍ້ຜິດພາດທີ່ຮ້າຍແຮງ. ການກຳນົດຊື່ OS ແມ່ນຈຳເປັນ\n"
"ເພື່ອຄ່າເລີ່ມຕົ້ນຂອງເຄື່ອງສະເໝືອນທີ່ທັນສະໄໝ, ມີປະສິດທິພາບ ແລະ ປອດໄພ.\n"

#: virtinst/virtinstall.py:605
msgid ""
"If you expected virt-install to detect an OS name from the\n"
"install media, you can set a fallback OS name with:\n"
"\n"
"  --osinfo detect=on,name=OSNAME\n"
msgstr ""
"ຫາກທ່ານຕ້ອງການໃຫ້ virt-install ກວດຫາຊື່ OS ຈາກ\n"
"ສື່ການຕິດຕັ້ງ, ທ່ານສາມາດຕັ້ງຊື່ OS ສຳຮອງໄດ້ດ້ວຍ:\n"
"\n"
"  --osinfo detect=on,name=OSNAME\n"

#: virtinst/virtinstall.py:615
msgid ""
"You can see a full list of possible OS name values with:\n"
"\n"
"   virt-install --osinfo list\n"
msgstr ""
"ທ່ານສາມາດເບິ່ງລາຍການຊື່ OS ທັງໝົດທີ່ເປັນໄປໄດ້ດ້ວຍ:\n"
"\n"
"   virt-install --osinfo list\n"

#: virtinst/virtinstall.py:622
#, python-brace-format
msgid ""
"If your Linux distro is not listed, try one of generic values\n"
"such as: {oslist}\n"
msgstr ""
"ຫາກ Linux distro ຂອງທ່ານບໍ່ມີໃນລາຍການ, ໃຫ້ລອງໃຊ້ຄ່າທົ່ວໄປ\n"
"ເຊັ່ນ: {oslist}\n"

#: virtinst/virtinstall.py:629
#, python-brace-format
msgid ""
"If you just need to get the old behavior back, you can use:\n"
"\n"
"  --osinfo detect=on,require=off\n"
"\n"
"Or export {env_var}=1\n"
msgstr ""
"ຫາກທ່ານຕ້ອງການກັບໄປໃຊ້ຮູບແບບເກົ່າ, ທ່ານສາມາດໃຊ້:\n"
"\n"
"  --osinfo detect=on,require=off\n"
"\n"
"ຫຼື export {env_var}=1\n"

#: virtinst/virtinstall.py:639
#, python-brace-format
msgid "{env_var} set. Skipping fatal error."
msgstr "ມີການຕັ້ງຄ່າ {env_var} ແລ້ວ. ຈະຂ້າມຂໍ້ຜິດພາດທີ່ຮ້າຍແຮງນີ້."

#: virtinst/virtinstall.py:723
msgid "No console to launch for the guest, defaulting to --wait -1"
msgstr "ບໍ່ມີຄອນໂຊລທີ່ຈະເປີດສຳລັບເກສ, ຈະໃຊ້ຄ່າເລີ່ມຕົ້ນເປັນ --wait -1"

#: virtinst/virtinstall.py:761
msgid "Waiting for the installation to complete."
msgstr "ກຳລັງຖ້າໃຫ້ການຕິດຕັ້ງສຳເລັດ."

#: virtinst/virtinstall.py:763
#, python-format
msgid "Waiting %(minutes)d minute for the installation to complete."
msgid_plural "Waiting %(minutes)d minutes for the installation to complete."
msgstr[0] "ກຳລັງຖ້າເປັນເວລາ %(minutes)d ນາທີ ເພື່ອໃຫ້ການຕິດຕັ້ງສຳເລັດ."

#: virtinst/virtinstall.py:787
#, python-format
msgid "Password for first root login is: %s"
msgstr "ລະຫັດຜ່ານສຳລັບການເຂົ້າລະຫັດ root ຄັ້ງທຳອິດແມ່ນ: %s"

#: virtinst/virtinstall.py:797
msgid "Installation will continue in 10 seconds (press Enter to skip)..."
msgstr "ການຕິດຕັ້ງຈະດຳເນີນການຕໍ່ໃນ 10 ວິນາທີ (ກົດ Enter ເພື່ອຂ້າມ)..."

#: virtinst/virtinstall.py:823
msgid "Console command returned failure."
msgstr "ຄຳສັ່ງຄອນໂຊລສົ່ງຄ່າຫຼົ້ມເຫຼວກັບຄືນມາ."

#: virtinst/virtinstall.py:862
msgid "Domain has crashed."
msgstr "ໂດເມນໄດ້ຢຸດເຮັດວຽກກະທັນຫັນ (crashed)."

#: virtinst/virtinstall.py:872
#, python-format
msgid "VM disappeared unexpectedly: %s"
msgstr "VM ຫາຍໄປໂດຍບໍ່ຄາດຄິດ: %s"

#: virtinst/virtinstall.py:894
msgid "Domain is still running. Installation may be in progress."
msgstr "ໂດເມນຍັງຄົງເຮັດວຽກຢູ່. ການຕິດຕັ້ງອາດຈະກຳລັງດຳເນີນຢູ່."

#: virtinst/virtinstall.py:904
msgid "You can reconnect to the console to complete the installation process."
msgstr "ທ່ານສາມາດເຊື່ອມຕໍ່ກັບຄອນໂຊລຄືນໃໝ່ເພື່ອເຮັດໃຫ້ຂັ້ນຕອນການຕິດຕັ້ງສຳເລັດ."

#: virtinst/virtinstall.py:914
msgid "Domain has shutdown. Continuing."
msgstr "ໂດເມນໄດ້ປິດລົງແລ້ວ. ກຳລັງດຳເນີນການຕໍ່."

#: virtinst/virtinstall.py:919
msgid "Installation has exceeded specified time limit. Exiting application."
msgstr "ການຕິດຕັ້ງເກີນກຳນົດເວລາທີ່ລະບຸໄວ້. ກຳລັງອອກຈາກແອັບພລິເຄຊັນ."

#: virtinst/virtinstall.py:941
msgid "Domain creation completed."
msgstr "ການສ້າງໂດເມນສຳເລັດແລ້ວ."

#: virtinst/virtinstall.py:950
#, python-format
msgid ""
"You can restart your domain by running:\n"
"  %s"
msgstr ""
"ທ່ານສາມາດເລີ່ມໂດເມນໃໝ່ໄດ້ໂດຍການລັນ:\n"
"  %s"

#: virtinst/virtinstall.py:955
msgid "User stopped the VM. Not rebooting."
msgstr "ຜູ້ໃຊ້ໄດ້ຢຸດ VM. ຈະບໍ່ມີການເລີ່ມລະບົບໃໝ່."

#: virtinst/virtinstall.py:958
msgid "Restarting guest."
msgstr "ກຳລັງເລີ່ມເກສໃໝ່."

#: virtinst/virtinstall.py:975
msgid ""
"\n"
"Starting install..."
msgstr ""
"\n"
"ກຳລັງເລີ່ມການຕິດຕັ້ງ..."

#: virtinst/virtinstall.py:1004
msgid "Domain install interrupted."
msgstr "ການຕິດຕັ້ງໂດເມນຖືກຂັດຈັງຫວະ."

#: virtinst/virtinstall.py:1023
msgid "Dry run completed successfully"
msgstr "ການທົດລອງລັນ (Dry run) ສຳເລັດແລ້ວ"

#: virtinst/virtinstall.py:1027
#, python-format
msgid "Unknown XML step request '%s', must be 1, 2, or all"
msgstr "ບໍ່ຮູ້ຈັກຄຳຮ້ອງຂໍຂັ້ນຕອນ XML '%s', ຕ້ອງເປັນ 1, 2, ຫຼື all"

#: virtinst/virtinstall.py:1033
msgid "Requested installation does not have XML step 2"
msgstr "ການຕິດຕັ້ງທີ່ຮ້ອງຂໍບໍ່ມີ XML ຂັ້ນຕອນທີ 2"

#: virtinst/virtinstall.py:1051
msgid "Create a new virtual machine from specified install media."
msgstr "ສ້າງເຄື່ອງສະເໝືອນໃໝ່ຈາກສື່ການຕິດຕັ້ງທີ່ກຳນົດ."

#: virtinst/virtinstall.py:1057
msgid "Name of the guest instance"
msgstr "ຊື່ຂອງເກສອິນສະແຕນຊ໌ (guest instance)"

#: virtinst/virtinstall.py:1065
msgid "Installation Method Options"
msgstr "ຕົວເລືອກວິທີການຕິດຕັ້ງ"

#: virtinst/virtinstall.py:1067
msgid "CD-ROM installation media"
msgstr "ສື່ການຕິດຕັ້ງ CD-ROM"

#: virtinst/virtinstall.py:1072
msgid ""
"Distro install URL, eg. https://host/path. See man page for specific distro "
"examples."
msgstr ""
"URL ສຳລັບການຕິດຕັ້ງ Distro, ເຊັ່ນ https://host/path. ເບິ່ງໜ້າ man ສຳລັບຕົວຢ່າງຂອງ distro "
"ຕ່າງໆ."

#: virtinst/virtinstall.py:1077
msgid "Boot from the network using the PXE protocol"
msgstr "ບູດຈາກເຄືອຂ່າຍໂດຍໃຊ້ໂປຣໂຕຄໍ PXE"

#: virtinst/virtinstall.py:1083
msgid "Build guest around an existing disk image"
msgstr "ສ້າງເກສໂດຍໃຊ້ອິມເມຈດિສກ໌ທີ່ມີຢູ່ແລ້ວ"

#: virtinst/virtinstall.py:1090
msgid ""
"Additional arguments to pass to the install kernel booted from --location"
msgstr "ອາກິວເມນເພີ່ມເຕີມທີ່ຈະສົ່ງໃຫ້ kernel ການຕິດຕັ້ງທີ່ບູດຈາກ --location"

#: virtinst/virtinstall.py:1095
msgid "Add given file to root of initrd from --location"
msgstr "ເພີ່ມໄຟລ໌ທີ່ກຳນົດໃຫ້ເຂົ້າໄປໃນ root ຂອງ initrd ຈາກ --location"

#: virtinst/virtinstall.py:1098
msgid "Perform an unattended installation"
msgstr "ດຳເນີນການຕິດຕັ້ງແບບອັດຕະໂນມັດ (unattended)"

#: virtinst/virtinstall.py:1100
msgid "Specify fine grained install options"
msgstr "ກຳນົດຕົວເລືອກການຕິດຕັ້ງແບບລະອຽດ"

#: virtinst/virtinstall.py:1105
msgid ""
"Reinstall existing VM. Only install options are applied, all other VM "
"configuration options are ignored."
msgstr ""
"ຕິດຕັ້ງ VM ທີ່ມີຢູ່ແລ້ວໃໝ່. ຈະມີພຽງຕົວເລືອກການຕິດຕັ້ງເທົ່ານັ້ນທີ່ມີຜົນ, ການຕັ້ງຄ່າ VM ອື່ນໆ ທັງໝົດຈະຖືກຂ້າມ."

#: virtinst/virtinstall.py:1113
msgid "Perform a cloud image installation, configuring cloud-init"
msgstr "ດຳເນີນການຕິດຕັ້ງ cloud image, ໂດຍຕັ້ງຄ່າ cloud-init"

#: virtinst/virtinstall.py:1127
msgid "Device Options"
msgstr "ຕົວເລືອກອຸປະກອນ"

#: virtinst/virtinstall.py:1152
msgid "Guest Configuration Options"
msgstr "ຕົວເລືອກການຕັ້ງຄ່າເກສ"

#: virtinst/virtinstall.py:1155
msgid "Virtualization Platform Options"
msgstr "ຕົວເລືອກແພລັດຟອມ Virtualization"

#: virtinst/virtinstall.py:1163
msgid "This guest should be a fully virtualized guest"
msgstr "ເກສນີ້ຄວນເປັນເກສແບບ virtualized ເຕັມຮູບແບບ (full virtualization)"

#: virtinst/virtinstall.py:1171
msgid "This guest should be a paravirtualized guest"
msgstr "ເກສນີ້ຄວນເປັນເກສແບບ paravirtualized"

#: virtinst/virtinstall.py:1178
msgid "This guest should be a container guest"
msgstr "ເກສນີ້ຄວນເປັນເກສແບບ container"

#: virtinst/virtinstall.py:1180
msgid "Hypervisor name to use (kvm, qemu, xen, ...)"
msgstr "ຊື່ຂອງໄຮເປີໄວເຊີທີ່ຈະໃຊ້ (kvm, qemu, xen, ...)"

#: virtinst/virtinstall.py:1181
msgid "The CPU architecture to simulate"
msgstr "ສະຖາປັດຕະຍະກຳ CPU ທີ່ຈະຈຳລອງ"

#: virtinst/virtinstall.py:1182
msgid "The machine type to emulate"
msgstr "ປະເພດຂອງເຄື່ອງທີ່ຈະຈຳລອງ"

#: virtinst/virtinstall.py:1192
msgid "Have domain autostart on host boot up."
msgstr "ໃຫ້ໂດເມນເລີ່ມອັດຕະໂນມັດເມື່ອໂຮສບູດເຄື່ອງ."

#: virtinst/virtinstall.py:1195
msgid "Create a transient domain."
msgstr "ສ້າງໂດເມນແບບຊົ່ວຄາວ (transient)."

#: virtinst/virtinstall.py:1201
msgid "Force power off the domain when the console viewer is closed."
msgstr "ບັງຄັບປິດໂດເມນເມື່ອຕົວເບິ່ງຄອນໂຊລຖືກປິດ."

#: virtinst/virtinstall.py:1204
msgid "Minutes to wait for install to complete."
msgstr "ຈຳນວນນາທີທີ່ຈະຖ້າໃຫ້ການຕິດຕັ້ງສຳເລັດ."

#: virtinst/virtxml.py:35
msgid "Please enter 'yes' or 'no'."
msgstr "ກະລຸນາປ້ອນ 'yes' ຫຼື 'no'."

#: virtinst/virtxml.py:105
msgid "--osinfo/--os-variant is not supported with --edit"
msgstr "ບໍ່ຮອງຮັບ --osinfo/--os-variant ພ້ອມກັບ --edit"

#: virtinst/virtxml.py:107
msgid "--osinfo/--os-variant is not supported with --remove-device"
msgstr "ບໍ່ຮອງຮັບ --osinfo/--os-variant ພ້ອມກັບ --remove-device"

#: virtinst/virtxml.py:109
msgid "--osinfo/--os-variant is not supported with --build-xml"
msgstr "ບໍ່ຮອງຮັບ --osinfo/--os-variant ພ້ອມກັບ --build-xml"

#: virtinst/virtxml.py:113
#, python-brace-format
msgid "--build-xml not supported for {cli_flag}"
msgstr "ບໍ່ຮອງຮັບ --build-xml ສຳລັບ {cli_flag}"

#: virtinst/virtxml.py:122
#, python-brace-format
msgid "Cannot use --remove-device with {cli_flag}"
msgstr "ບໍ່ສາມາດໃຊ້ --remove-device ພ້ອມກັບ {cli_flag}"

#: virtinst/virtxml.py:128
#, python-brace-format
msgid "Cannot use --add-device with {cli_flag}"
msgstr "ບໍ່ສາມາດໃຊ້ --add-device ພ້ອມກັບ {cli_flag}"

#: virtinst/virtxml.py:135
#, python-brace-format
msgid "Don't know how to --update for {cli_flag}"
msgstr "ບໍ່ຮູ້ວິທີ --update ສຳລັບ {cli_flag}"

#: virtinst/virtxml.py:151
#, python-format
msgid "One of %s must be specified."
msgstr "ຕ້ອງມີການກຳນົດຢ່າງໃດຢ່າງໜຶ່ງໃນ %s."

#: virtinst/virtxml.py:153
#, python-format
msgid "Conflicting options %s"
msgstr "ຕົວເລືອກ %s ຂັດແຍ່ງກັນ"

#: virtinst/virtxml.py:167
msgid "No change specified."
msgstr "ບໍ່ມີການກຳນົດການປ່ຽນແປງໃດໆ."

#: virtinst/virtxml.py:170
#, python-format
msgid "Only one change operation may be specified (conflicting options %s)"
msgstr ""
"ສາມາດກຳນົດການດຳເນີນການປ່ຽນແປງໄດ້ພຽງຢ່າງດຽວເທົ່ານັ້ນ (ຕົວເລືອກ %s ຂັດແຍ່ງກັນ)"

#: virtinst/virtxml.py:212
#, python-format
msgid "Invalid --edit option '%s'"
msgstr "ຕົວເລືອກ --edit '%s' ບໍ່ຖືກຕ້ອງ"

#: virtinst/virtxml.py:216
#, python-brace-format
msgid "No {cli_flag} objects found in the XML"
msgstr "ບໍ່ພົບ object {cli_flag} ໃນ XML"

#: virtinst/virtxml.py:223
#, python-brace-format
msgid ""
"'--edit {number}' requested but there's only {maxnum} {cli_flag} object in "
"the XML"
msgid_plural ""
"'--edit {number}' requested but there are only {maxnum} {cli_flag} objects "
"in the XML"
msgstr[0] ""
"ມີການຮ້ອງຂໍ '--edit {number}' ແຕ່ມີ object {cli_flag} ພຽງແຕ່ {maxnum} ອັນໃນ XML"

#: virtinst/virtxml.py:244
#, python-format
msgid "No matching objects found for %s"
msgstr "ບໍ່ພົບ object ທີ່ກົງກັບ %s"

#: virtinst/virtxml.py:261
#, python-brace-format
msgid ""
"'--edit {option}' doesn't make sense with {cli_flag}, just use empty '--edit'"
msgstr ""
"'--edit {option}' ບໍ່ສົມເຫດສົມຜົນກັບ {cli_flag}, ໃຫ້ໃຊ້ພຽງແຕ່ '--edit' ຫວ່າງໆ"

#: virtinst/virtxml.py:334
#, python-format
msgid "Define '%s' with the changed XML?"
msgstr "ຕ້ອງການກຳນົດ (define) '%s' ດ້ວຍ XML ທີ່ປ່ຽນແປງແລ້ວແມ່ນບໍ່?"

#: virtinst/virtxml.py:342
#, python-format
msgid "Domain '%s' defined successfully."
msgstr "ກຳນົດໂດເມນ '%s' ສຳເລັດແລ້ວ."

#: virtinst/virtxml.py:348
#, python-format
msgid "Start '%s' with the changed XML?"
msgstr "ຕ້ອງການເລີ່ມ '%s' ດ້ວຍ XML ທີ່ປ່ຽນແປງແລ້ວແມ່ນບໍ່?"

#: virtinst/virtxml.py:359 virtinst/virtxml.py:671
#, python-format
msgid "Failed starting domain '%(domain)s': %(error)s"
msgstr "ເລີ່ມໂດເມນ '%(domain)s' ຫຼົ້ມເຫຼວ: %(error)s"

#: virtinst/virtxml.py:366 virtinst/virtxml.py:677
#, python-format
msgid "Domain '%s' started successfully."
msgstr "ເລີ່ມໂດເມນ '%s' ສຳເລັດແລ້ວ."

#: virtinst/virtxml.py:372
#, python-format
msgid ""
"%(xml)s\n"
"\n"
"Hotplug this device to the guest '%(domain)s'?"
msgstr ""
"%(xml)s\n"
"\n"
"ຕ້ອງການເຮັດ Hotplug ອຸປະກອນນີ້ໃສ່ເກສ '%(domain)s' ແມ່ນບໍ່?"

#: virtinst/virtxml.py:373
msgid "Device hotplug successful."
msgstr "ເຮັດ Hotplug ອຸປະກອນສຳເລັດແລ້ວ."

#: virtinst/virtxml.py:374
#, python-format
msgid "Error attempting device hotplug: %(error)s"
msgstr "ເກີດຂໍ້ຜິດພາດໃນການພະຍາຍາມເຮັດ Hotplug ອຸປະກອນ: %(error)s"

#: virtinst/virtxml.py:376
#, python-format
msgid ""
"%(xml)s\n"
"\n"
"Hotunplug this device from the guest '%(domain)s'?"
msgstr ""
"%(xml)s\n"
"\n"
"ຕ້ອງການເຮັດ Hotunplug ອຸປະກອນນີ້ອອກຈາກເກສ '%(domain)s' ແມ່ນບໍ່?"

#: virtinst/virtxml.py:377
msgid "Device hotunplug successful."
msgstr "ເຮັດ Hotunplug ອຸປະກອນສຳເລັດແລ້ວ."

#: virtinst/virtxml.py:378
#, python-format
msgid "Error attempting device hotunplug: %(error)s"
msgstr "ເກີດຂໍ້ຜິດພາດໃນການພະຍາຍາມເຮັດ Hotunplug ອຸປະກອນ: %(error)s"

#: virtinst/virtxml.py:380
#, python-format
msgid ""
"%(xml)s\n"
"\n"
"Update this device for the guest '%(domain)s'?"
msgstr ""
"%(xml)s\n"
"\n"
"ຕ້ອງການອັບເດດອຸປະກອນນີ້ສຳລັບເກສ '%(domain)s' ແມ່ນບໍ່?"

#: virtinst/virtxml.py:381
msgid "Device update successful."
msgstr "ອັບເດດອຸປະກອນສຳເລັດແລ້ວ."

#: virtinst/virtxml.py:382
#, python-format
msgid "Error attempting device update: %(error)s"
msgstr "ເກີດຂໍ້ຜິດພາດໃນການພະຍາຍາມອັບເດດອຸປະກອນ: %(error)s"

#: virtinst/virtxml.py:433
msgid "No XML diff was generated. The requested changes will have no effect."
msgstr "ບໍ່ມີການສ້າງ XML diff. ການປ່ຽນແປງທີ່ຮ້ອງຂໍຈະບໍ່ມີຜົນຫຍັງ."

#: virtinst/virtxml.py:452
msgid "Edit libvirt XML using command line options."
msgstr "ແກ້ໄຂ XML ຂອງ libvirt ໂດຍໃຊ້ຕົວເລືອກຄຳສັ່ງ (command line)."

#: virtinst/virtxml.py:458
msgid "Domain name, id, or uuid"
msgstr "ຊື່ໂດເມນ, id, ຫຼື uuid"

#: virtinst/virtxml.py:460
msgid "XML actions"
msgstr "ການດຳເນີນການ XML"

#: virtinst/virtxml.py:466
msgid ""
"Edit VM XML. Examples:\n"
"--edit --disk ...     (edit first disk device)\n"
"--edit 2 --disk ...   (edit second disk device)\n"
"--edit all --disk ... (edit all disk devices)\n"
"--edit target=hda --disk ... (edit disk 'hda')\n"
msgstr ""
"ແກ້ໄຂ XML ຂອງ VM. ຕົວຢ່າງ:\n"
"--edit --disk ...     (ແກ້ໄຂອຸປະກອນດິສກ໌ອັນທຳອິດ)\n"
"--edit 2 --disk ...   (ແກ້ໄຂອຸປະກອນດິສກ໌ອັນທີສອງ)\n"
"--edit all --disk ... (ແກ້ໄຂອຸປະກອນດິສກ໌ທັງໝົດ)\n"
"--edit target=hda --disk ... (ແກ້ໄຂດິສກ໌ 'hda')\n"

#: virtinst/virtxml.py:477
msgid ""
"Remove specified device. Examples:\n"
"--remove-device --disk 1 (remove first disk)\n"
"--remove-device --disk all (remove all disks)\n"
"--remove-device --disk /some/path"
msgstr ""
"ລຶບອຸປະກອນທີ່ກຳນົດ. ຕົວຢ່າງ:\n"
"--remove-device --disk 1 (ລຶບດິສກ໌ອັນທຳອິດ)\n"
"--remove-device --disk all (ລຶບດິສກ໌ທັງໝົດ)\n"
"--remove-device --disk /some/path"

#: virtinst/virtxml.py:486
msgid ""
"Add specified device. Example:\n"
"--add-device --disk ..."
msgstr ""
"ເພີ່ມອຸປະກອນທີ່ກຳນົດ. ຕົວຢ່າງ:\n"
"--add-device --disk ..."

#: virtinst/virtxml.py:492
msgid ""
"Output built device XML. Domain is optional but recommended to ensure "
"optimal defaults."
msgstr ""
"ສະແດງຜົນ XML ຂອງອຸປະກອນທີ່ສ້າງຂຶ້ນ. ໂດເມນແມ່ນຕົວເລືອກເສີມແຕ່ແນະນຳໃຫ້ໃສ່ເພື່ອຄ່າເລີ່ມຕົ້ນທີ່ດີທີ່ສຸດ."

#: virtinst/virtxml.py:497
msgid "Output options"
msgstr "ຕົວເລືອກການສະແດງຜົນ"

#: virtinst/virtxml.py:502
msgid ""
"Apply changes to the running VM.\n"
"With --add-device, this is a hotplug operation.\n"
"With --remove-device, this is a hotunplug operation.\n"
"With --edit, this is an update device operation."
msgstr ""
"ນຳໃຊ້ການປ່ຽນແປງກັບ VM ທີ່ກຳລັງເຮັດວຽກຢູ່.\n"
"ຫາກໃຊ້ກັບ --add-device, ນີ້ຈະເປັນການເຮັດ hotplug.\n"
"ຫາກໃຊ້ກັບ --remove-device, ນີ້ຈະເປັນການເຮັດ hotunplug.\n"
"ຫາກໃຊ້ກັບ --edit, ນີ້ຈະເປັນການອັບເດດອຸປະກອນ."

#: virtinst/virtxml.py:512
msgid ""
"Force defining the domain. Only required if a --print option was specified."
msgstr ""
"ບັງຄັບໃຫ້ກຳນົດ (define) ໂດເມນ. ຈຳເປັນຕ້ອງໃຊ້ກໍຕໍ່ເມື່ອມີການກຳນົດຕົວເລືອກ --print ເທົ່ານັ້ນ."

#: virtinst/virtxml.py:515
msgid "Force not defining the domain."
msgstr "ບັງຄັບບໍ່ໃຫ້ກຳນົດ (define) ໂດເມນ."

#: virtinst/virtxml.py:518
msgid "Start the domain."
msgstr "ເລີ່ມໂດເມນ."

#: virtinst/virtxml.py:522
msgid "Only print the requested change, in diff format"
msgstr "ພິມສະເພາະການປ່ຽນແປງທີ່ຮ້ອງຂໍ ໃນຮູບແບບ diff"

#: virtinst/virtxml.py:527
msgid "Only print the requested change, in full XML format"
msgstr "ພິມສະເພາະການປ່ຽນແປງທີ່ຮ້ອງຂໍ ໃນຮູບແບບ XML ເຕັມ"

#: virtinst/virtxml.py:530
msgid "Require confirmation before saving any results."
msgstr "ຕ້ອງການການຢືນຢັນກ່ອນທີ່ຈະບັນທຶກຜົນໃດໆ."

#: virtinst/virtxml.py:535
msgid "Conversion options"
msgstr "ຕົວເລືອກການແປງຄ່າ (conversion)"

#: virtinst/virtxml.py:541
msgid "Convert an existing VM from PC/i440FX to Q35."
msgstr "ແປງ VM ທີ່ມີຢູ່ຈາກ PC/i440FX ໄປເປັນ Q35."

#: virtinst/virtxml.py:550
msgid ""
"Convert an existing VM to use VNC graphics. This removes any remnants of "
"Spice graphics."
msgstr ""
"ແປງ VM ທີ່ມີຢູ່ໃຫ້ໃຊ້ກຣາຟິກ VNC. ສິ່ງນີ້ຈະລຶບສ່ວນທີ່ເຫຼືອຂອງກຣາຟິກ Spice ອອກທັງໝົດ."

#: virtinst/virtxml.py:555
msgid "XML options"
msgstr "ຕົວເລືອກ XML"

#: virtinst/virtxml.py:597
msgid "Can't use --confirm with stdin input."
msgstr "ບໍ່ສາມາດໃຊ້ --confirm ກັບ stdin input ໄດ້."

#: virtinst/virtxml.py:599
msgid "Can't use --update with stdin input."
msgstr "ບໍ່ສາມາດໃຊ້ --update ກັບ stdin input ໄດ້."

#: virtinst/virtxml.py:602
msgid "A domain must be specified"
msgstr "ຕ້ອງມີການກຳນົດໂດເມນ"

#: virtinst/virtxml.py:647
msgid "The VM is not running, --update is inapplicable."
msgstr "VM ບໍ່ໄດ້ກຳລັງເຮັດວຽກຢູ່, --update ຈຶ່ງບໍ່ມີຜົນ."

#: virtinst/virtxml.py:680
msgid "Changes will take effect after the domain is fully powered off."
msgstr "ການປ່ຽນແປງຈະມີຜົນຫຼັງຈາກທີ່ໂດເມນຖືກປິດເຄື່ອງຢ່າງສົມບູນ."

#: virtinst/virtxml.py:684
msgid ""
"XML did not change after domain define. You may have changed a value that "
"libvirt is setting by default."
msgstr ""
"XML ບໍ່ມີການປ່ຽນແປງຫຼັງຈາກກຳນົດໂດເມນ. ທ່ານອາດຈະປ່ຽນຄ່າທີ່ libvirt ກຳນົດໄວ້ເປັນຄ່າເລີ່ມຕົ້ນຢູ່ແລ້ວ."

#: virtinst/virtxml.py:699
msgid "Aborted at user request"
msgstr "ຍົກເລີກຕາມຄຳຮ້ອງຂໍຂອງຜູ້ໃຊ້"

#: virtinst/xmlapi.py:211
#, python-format
msgid ""
"XML did not have expected root element name '%(expectname)s', found "
"'%(foundname)s'"
msgstr ""
"XML ບໍ່ມີຊື່ root element ຕາມທີ່ຄາດໄວ້ '%(expectname)s', ພົບ '%(foundname)s'"

#. translators: value is a generic object type name
#: virtinst/xmlbuilder.py:517
#, python-format
msgid "A name must be specified for the %s"
msgstr "ຕ້ອງກຳນົດຊື່ສຳລັບ %s"

#: virtinst/xmlbuilder.py:521
#, python-format
msgid "%(objecttype)s name '%(name)s' can not contain '%(char)s' character."
msgstr "ຊື່ %(objecttype)s '%(name)s' ບໍ່ສາມາດມີຕົວອັກສອນ '%(char)s' ໄດ້."
