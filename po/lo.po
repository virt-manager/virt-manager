#, python-format
msgid "%(vm-name)s on %(connection-name)s"
msgstr "%(vm-name)s ຢູ່ %(connection-name)s"

#: virtManager/vmwindow.py:420
msgid "Manage VM snapshots"
msgstr "ຈັດການ snapshot ຂອງ VM"

#: virtManager/vmwindow.py:497
#, python-format
msgid "Error taking screenshot: %s"
msgstr "ເກີດຂໍ້ຜິດພາດໃນການຖ່າຍຮູບໜ້າຈໍ: %s"

#: virtManager/vmwindow.py:505
msgid "Error initializing spice USB device widget"
msgstr "ເກີດຂໍ້ຜິດພາດໃນການເລີ່ມຕົ້ນ widget ຂອງອຸປະກອນ USB spice"

#: virtManager/vmwindow.py:510
msgid "Select USB devices for redirection"
msgstr "ເລືອກອຸປະກອນ USB ສຳລັບການປ່ຽນເສັ້ນທາງ (redirection)"

#: virtManager/vmwindow.py:545
msgid "Save Virtual Machine Screenshot"
msgstr "ບັນທຶກຮູບໜ້າຈໍຂອງເຄື່ອງສະເໝືອນ"

#: virtManager/vmwindow.py:546
msgid "PNG files"
msgstr "ໄຟລ໌ PNG"

#: virtManager/vmwindow.py:548
msgid "_Save"
msgstr "_ບັນທຶກ"

#: virtManager/xmleditor.py:131 virtManager/xmleditor.py:144
msgid "There are unapplied changes."
msgstr "ມີການປ່ຽນແປງທີ່ຍັງບໍ່ທັນໄດ້ນຳໃຊ້."

#: virtManager/xmleditor.py:132
msgid "Your changes will be lost if you leave this tab. Really leave this tab?"
msgstr ""
"ການປ່ຽນແປງຂອງທ່ານຈະສູນຫາຍຫາກທ່ານອອກຈາກແທັບນີ້. ຕ້ອງການອອກຈາກແທັບນີ້ແທ້ບໍ່?"

#: virtManager/xmleditor.py:145
msgid ""
"Your XML changes will be lost if you leave this tab. Really leave this tab?"
msgstr ""
"ການປ່ຽນແປງ XML ຂອງທ່ານຈະສູນຫາຍຫາກທ່ານອອກຈາກແທັບນີ້. ຕ້ອງການອອກຈາກແທັບນີ້ແທ້ບໍ່?"

#: virtinst/capabilities.py:300
#, python-format
msgid ""
"Host does not support virtualization type '%(virttype)s' for architecture "
"'%(arch)s'"
msgstr ""
"ໂຮສ (Host) ບໍ່ຮອງຮັບປະເພດ virtualization '%(virttype)s' ສຳລັບສະຖາປັດຕະຍະກຳ '%"
"(arch)s'"

#: virtinst/capabilities.py:305
#, python-format
msgid ""
"Host does not support any virtualization options for architecture '%(arch)s'"
msgstr ""
"ໂຮສ (Host) ບໍ່ຮອງຮັບຕົວເລືອກ virtualization ໃດໆ ສຳລັບສະຖາປັດຕະຍະກຳ '%(arch)s'"

#: virtinst/capabilities.py:309
#, python-format
msgid "Host does not support virtualization type '%(virttype)s'"
msgstr "ໂຮສ (Host) ບໍ່ຮອງຮັບປະເພດ virtualization '%(virttype)s'"

#: virtinst/capabilities.py:313
msgid "Host does not support any virtualization options"
msgstr "ໂຮສ (Host) ບໍ່ຮອງຮັບຕົວເລືອກ virtualization ໃດໆ"

#: virtinst/capabilities.py:320
#, python-format
msgid ""
"Host does not support domain type %(domain)s with machine '%(machine)s' for "
"virtualization type '%(virttype)s' with architecture '%(arch)s'"
msgstr ""
"ໂຮສ (Host) ບໍ່ຮອງຮັບໂດເມນປະເພດ %(domain)s ກັບເຄື່ອງ '%(machine)s' ສຳລັບ "
"virtualization ປະເພດ '%(virttype)s' ທີ່ມີສະຖາປັດຕະຍະກຳ '%(arch)s'"

#: virtinst/capabilities.py:331
#, python-format
msgid ""
"Host does not support domain type %(domain)s for virtualization type "
"'%(virttype)s' with architecture '%(arch)s'"
msgstr ""
"ໂຮສ (Host) ບໍ່ຮອງຮັບໂດເມນປະເພດ %(domain)s ສຳລັບ virtualization ປະເພດ '%(virttype)"
"s' ທີ່ມີສະຖາປັດຕະຍະກຳ '%(arch)s'"

#: virtinst/cli.py:115
msgid "See man page for examples and full option syntax."
msgstr "ເບິ່ງໜ້າ man ສຳລັບຕົວຢ່າງ ແລະ ໄວຍາກອນຕົວເລືອກແບບເຕັມ."

#: virtinst/cli.py:118
msgid "Use '--option=?' or '--option help' to see available suboptions"
msgstr "ໃຊ້ '--option=?' ຫຼື '--option help' ເພື່ອເບິ່ງຕົວເລືອກຍ່ອຍທີ່ມີໃຫ້"

#: virtinst/cli.py:295
#, python-format
msgid ""
"Domain installation does not appear to have been successful.\n"
"If it was, you can restart your domain by running:\n"
"  %s\n"
"otherwise, please restart your installation."
msgstr ""
"ເບິ່ງຄືວ່າການຕິດຕັ້ງໂດເມນບໍ່ສຳເລັດ.\n"
"ຫາກມັນສຳເລັດແລ້ວ, ທ່ານສາມາດເລີ່ມໂດເມນໃໝ່ໄດ້ໂດຍການລັນ:\n"
"  %s\n"
"ຖ້າບໍ່ດັ່ງນັ້ນ, ກະລຸນາເລີ່ມຕົ້ນການຕິດຕັ້ງໃໝ່."

#: virtinst/cli.py:316
#, python-format
msgid ""
"%(path)s may not be accessible by the hypervisor. You will need to grant the "
"'%(user)s' user search permissions for the following directories: %(dirs)s"
msgstr ""
"%(path)s ອາດຈະບໍ່ສາມາດເຂົ້າເຖິງໄດ້ໂດຍໄຮເປີໄວເຊີ (hypervisor). ທ່ານຈຳເປັນຕ້ອງໃຫ້ສິດການຄົ້ນຫາແ"
"ກ່ຜູ້ໃຊ້ '%(user)s' ສຳລັບໂຟນເດີຕໍ່ໄປນີ້: %(dirs)s"

#: virtinst/cli.py:329
#, python-format
msgid " (Use --check %s=off or --check all=off to override)"
msgstr " (ໃຊ້ --check %s=off ຫຼື --check all=off ເພື່ອຂ້າມການກວດສອບ)"

#: virtinst/cli.py:360
#, python-format
msgid "This will overwrite the existing path '%s'"
msgstr "ການເຮັດແນວນີ້ຈະຂຽນທັບເສັ້ນທາງທີ່ມີຢູ່ແລ້ວ '%s'"

#: virtinst/cli.py:370
#, python-format
msgid "Disk %(path)s is already in use by other guests %(names)s."
msgstr "ດິສກ໌ %(path)s ຖືກໃຊ້ງານຢູ່ໂດຍເກສ (guest) ອື່ນ %(names)s."

#: virtinst/cli.py:414
#, python-format
msgid "Running graphical console command: %(command)s"
msgstr "ກຳລັງລັນຄຳສັ່ງຄອນໂຊລແບບກຣາຟິກ: %(command)s"

#: virtinst/cli.py:426
#, python-format
msgid "Running text console command: %(command)s"
msgstr "ກຳລັງລັນຄຳສັ່ງຄອນໂຊລແບບຂໍ້ຄວາມ: %(command)s"

#: virtinst/cli.py:470
#, python-format
msgid "Could not find domain '%(domain)s': %(error)s"
msgstr "ບໍ່ພົບໂດເມນ '%(domain)s': %(error)s"

#. translators: option1 and option2 are command line options,
#. e.g. -a or --disk
#: virtinst/cli.py:490
#, python-format
msgid "Cannot use %(option1)s and %(option2)s at the same time"
msgstr "ບໍ່ສາມາດໃຊ້ %(option1)s ແລະ %(option2)s ໃນເວລາດຽວກັນໄດ້"

#: virtinst/cli.py:608 virtinst/cli.py:612
msgid "Connect to hypervisor with libvirt URI"
msgstr "ເຊື່ອມຕໍ່ກັບໄຮເປີໄວເຊີ (hypervisor) ດ້ວຍ libvirt URI"

#: virtinst/cli.py:635
msgid ""
"Configure guest console auto connect. Example:\n"
"--autoconsole text\n"
"--autoconsole graphical\n"
"--autoconsole none"
msgstr ""
"ຕັ້ງຄ່າການເຊື່ອມຕໍ່ຄອນໂຊລຂອງເກສໂດຍອັດຕະໂນມັດ. ຕົວຢ່າງ:\n"
"--autoconsole text\n"
"--autoconsole graphical\n"
"--autoconsole none"

#: virtinst/cli.py:646
msgid "Don't automatically try to connect to the guest console"
msgstr "ບໍ່ຕ້ອງພະຍາຍາມເຊື່ອມຕໍ່ກັບຄອນໂຊລຂອງເກສໂດຍອັດຕະໂນມັດ"

#: virtinst/cli.py:651
msgid "Don't boot guest after completing install."
msgstr "ບໍ່ຕ້ອງບູດເກສຫຼັງຈາກການຕິດຕັ້ງສຳເລັດ."

#: virtinst/cli.py:658
msgid "Don't check name collision, overwrite any guest with the same name."
msgstr "ບໍ່ຕ້ອງກວດສອບຊື່ທີ່ຊ້ຳກັນ, ໃຫ້ຂຽນທັບເກສໃດໆທີ່ມີຊື່ຄືກັນ."

#: virtinst/cli.py:665
msgid "Print the generated domain XML rather than create the guest."
msgstr "ສະແດງຜົນ XML ຂອງໂດເມນທີ່ສ້າງຂຶ້ນ ແທນທີ່ຈະສ້າງເກສຕົວຈິງ."

#: virtinst/cli.py:685
msgid ""
"Run through install process, but do not create devices or define the guest."
msgstr "ດຳເນີນການຕາມຂັ້ນຕອນການຕິດຕັ້ງ, ແຕ່ບໍ່ຕ້ອງສ້າງອຸປະກອນ ຫຼື ກຳນົດຄ່າເກສ."

#: virtinst/cli.py:693
msgid ""
"Enable or disable validation checks. Example:\n"
"--check path_in_use=off\n"
"--check all=off"
msgstr ""
"ເປີດ ຫຼື ປິດການກວດສອບຄວາມຖືກຕ້ອງ. ຕົວຢ່າງ:\n"
"--check path_in_use=off\n"
"--check all=off"

#: virtinst/cli.py:698
msgid "Suppress non-error output"
msgstr "ປິດການສະແດງຜົນທີ່ບໍ່ແມ່ນຂໍ້ຜິດພາດ"

#: virtinst/cli.py:699
msgid "Print debugging information"
msgstr "ສະແດງຂໍ້ມູນການດີບັກ (debugging)"

#: virtinst/cli.py:708
msgid ""
"Configure guest metadata. Ex:\n"
"--metadata name=foo,title=\"My pretty title\",uuid=...\n"
"--metadata description=\"My nice long description\""
msgstr ""
"ຕັ້ງຄ່າ metadata ຂອງເກສ. ຕົວຢ່າງ:\n"
"--metadata name=foo,title=\"My pretty title\",uuid=...\n"
"--metadata description=\"My nice long description\""

#: virtinst/cli.py:721
msgid ""
"Configure guest memory allocation. Ex:\n"
"--memory 1024 (in MiB)\n"
"--memory memory=1024,currentMemory=512\n"
msgstr ""
"ຕັ້ງຄ່າການຈອງໜ່ວຍຄວາມຈຳຂອງເກສ. ຕົວຢ່າງ:\n"
"--memory 1024 (ເປັນ MiB)\n"
"--memory memory=1024,currentMemory=512\n"

#: virtinst/cli.py:738
msgid ""
"Number of vCPUs to configure for your guest. Ex:\n"
"--vcpus 5\n"
"--vcpus 5,maxvcpus=10,cpuset=1-4,6,8\n"
"--vcpus sockets=2,cores=4,threads=2"
msgstr ""
"ຈຳນວນ vCPUs ທີ່ຈະຕັ້ງຄ່າສຳລັບເກສຂອງທ່ານ. ຕົວຢ່າງ:\n"
"--vcpus 5\n"
"--vcpus 5,maxvcpus=10,cpuset=1-4,6,8\n"
"--vcpus sockets=2,cores=4,threads=2"

#: virtinst/cli.py:751
msgid ""
"CPU model and features. Ex:\n"
"--cpu coreduo,+x2apic\n"
"--cpu host-passthrough\n"
msgstr ""
"ລຸ້ນ ແລະ ຄຸນສົມບັດຂອງ CPU. ຕົວຢ່າງ:\n"
"--cpu coreduo,+x2apic\n"
"--cpu host-passthrough\n"

#: virtinst/cli.py:766
msgid ""
"Configure guest display settings. Ex:\n"
"--graphics spice\n"
"--graphics vnc,port=5901,listen=0.0.0.0\n"
"--graphics none\n"
msgstr ""
"ຕັ້ງຄ່າການສະແດງຜົນຂອງເກສ. ຕົວຢ່າງ:\n"
"--graphics spice\n"
"--graphics vnc,port=5901,listen=0.0.0.0\n"
"--graphics none\n"

#: virtinst/cli.py:781
msgid ""
"Configure a guest network interface. Ex:\n"
"--network bridge=mybr0\n"
"--network network=my_libvirt_virtual_net\n"
"--network network=mynet,model=virtio,mac=00:11...\n"
"--network none\n"
"--network help"
msgstr ""
"ຕັ້ງຄ່າອິນເຕີເຟສເຄືອຂ່າຍຂອງເກສ. ຕົວຢ່າງ:\n"
"--network bridge=mybr0\n"
"--network network=my_libvirt_virtual_net\n"
"--network network=mynet,model=virtio,mac=00:11...\n"
"--network none\n"
"--network help"

#: virtinst/cli.py:797
msgid ""
"Configure a guest controller device. Ex:\n"
"--controller type=usb,model=qemu-xhci\n"
"--controller type=scsi,model=virtio-scsi\n"
msgstr ""
"ຕັ້ງຄ່າອຸປະກອນຄອນໂທຣເລີຂອງເກສ. ຕົວຢ່າງ:\n"
"--controller type=usb,model=qemu-xhci\n"
"--controller type=scsi,model=virtio-scsi\n"

#: virtinst/cli.py:806
msgid ""
"Configure a guest input device. Ex:\n"
"--input tablet\n"
"--input keyboard,bus=usb"
msgstr ""
"ຕັ້ງຄ່າອຸປະກອນນຳເຂົ້າຂໍ້ມູນຂອງເກສ. ຕົວຢ່າງ:\n"
"--input tablet\n"
"--input keyboard,bus=usb"

#: virtinst/cli.py:809
msgid "Configure a guest serial device"
msgstr "ຕັ້ງຄ່າອຸປະກອນຊີຣຽວ (serial) ຂອງເກສ"

#: virtinst/cli.py:811
msgid "Configure a guest parallel device"
msgstr "ຕັ້ງຄ່າອຸປະກອນພານາເຣວ (parallel) ຂອງເກສ"

#: virtinst/cli.py:814
msgid "Configure a guest communication channel"
msgstr "ຕັ້ງຄ່າຊ່ອງທາງການສື່ສານຂອງເກສ"

#: virtinst/cli.py:820
msgid "Configure a text console connection between the guest and host"
msgstr "ຕັ້ງຄ່າການເຊື່ອມຕໍ່ຄອນໂຊລແບບຂໍ້ຄວາມລະຫວ່າງເກສ ແລະ ໂຮສ"

#: virtinst/cli.py:826
msgid "Configure physical USB/PCI/etc host devices to be shared with the guest"
msgstr "ຕັ້ງຄ່າອຸປະກອນ USB/PCI/ແລະ ອື່ນໆ ຂອງໂຮສເພື່ອແບ່ງປັນໃຫ້ເກສ"

#: virtinst/cli.py:836
msgid ""
"Pass host directory to the guest. Ex: \n"
"--filesystem /my/source/dir,/dir/in/guest\n"
"--filesystem template_name,/,type=template"
msgstr ""
"ສົ່ງໂຟນເດີຂອງໂຮສໃຫ້ເກສ. ຕົວຢ່າງ: \n"
"--filesystem /my/source/dir,/dir/in/guest\n"
"--filesystem template_name,/,type=template"

#: virtinst/cli.py:846
msgid "Configure guest sound device emulation"
msgstr "ຕັ້ງຄ່າການຈຳລອງອຸປະກອນສຽງຂອງເກສ"

#: virtinst/cli.py:856
msgid "Configure host audio backend for sound devices"
msgstr "ຕັ້ງຄ່າ audio backend ຂອງໂຮສສຳລັບອຸປະກອນສຽງ"

#: virtinst/cli.py:860
msgid "Configure a guest watchdog device"
msgstr "ຕັ້ງຄ່າອຸປະກອນ watchdog ຂອງເກສ"

#: virtinst/cli.py:862
msgid "Configure guest video hardware."
msgstr "ຕັ້ງຄ່າຮາດແວວິດີໂອຂອງເກສ."

#: virtinst/cli.py:867
msgid ""
"Configure a guest smartcard device. Ex:\n"
"--smartcard mode=passthrough"
msgstr ""
"ຕັ້ງຄ່າອຸປະກອນສະມາດກາດ (smartcard) ຂອງເກສ. ຕົວຢ່າງ:\n"
"--smartcard mode=passthrough"

#: virtinst/cli.py:874
msgid ""
"Configure a guest redirection device. Ex:\n"
"--redirdev usb,type=tcp,server=192.168.1.1:4000"
msgstr ""
"ຕັ້ງຄ່າອຸປະກອນປ່ຽນເສັ້ນທາງ (redirection) ຂອງເກສ. ຕົວຢ່າງ:\n"
"--redirdev usb,type=tcp,server=192.168.1.1:4000"

#: virtinst/cli.py:882
msgid ""
"Configure a guest memballoon device. Ex:\n"
"--memballoon model=virtio"
msgstr ""
"ຕັ້ງຄ່າອຸປະກອນ memballoon ຂອງເກສ. ຕົວຢ່າງ:\n"
"--memballoon model=virtio"

#: virtinst/cli.py:886
msgid ""
"Configure a guest TPM device. Ex:\n"
"--tpm /dev/tpm"
msgstr ""
"ຕັ້ງຄ່າອຸປະກອນ TPM ຂອງເກສ. ຕົວຢ່າງ:\n"
"--tpm /dev/tpm"

#: virtinst/cli.py:890
msgid ""
"Configure a guest RNG device. Ex:\n"
"--rng /dev/urandom"
msgstr ""
"ຕັ້ງຄ່າອຸປະກອນ RNG ຂອງເກສ. ຕົວຢ່າງ:\n"
"--rng /dev/urandom"

#: virtinst/cli.py:896
msgid ""
"Configure a guest panic device. Ex:\n"
"--panic default"
msgstr ""
"ຕັ້ງຄ່າອຸປະກອນ panic ຂອງເກສ. ຕົວຢ່າງ:\n"
"--panic default"

#: virtinst/cli.py:902
msgid ""
"Configure a guest shared memory device. Ex:\n"
"--shmem name=shmem0"
msgstr ""
"ຕັ້ງຄ່າອຸປະກອນແບ່ງປັນໜ່ວຍຄວາມຈຳ (shared memory) ຂອງເກສ. ຕົວຢ່າງ:\n"
"--shmem name=shmem0"

#: virtinst/cli.py:908
msgid ""
"Configure a guest memory device. Ex:\n"
"--memdev dimm,target.size=1024"
msgstr ""
"ຕັ້ງຄ່າອຸປະກອນໜ່ວຍຄວາມຈຳຂອງເກສ. ຕົວຢ່າງ:\n"
"--memdev dimm,target.size=1024"

#: virtinst/cli.py:914
msgid ""
"Configure guest vsock sockets. Ex:\n"
"--vsock cid.auto=yes\n"
"--vsock cid.address=7"
msgstr ""
"ຕັ້ງຄ່າ vsock sockets ຂອງເກສ. ຕົວຢ່າງ:\n"
"--vsock cid.auto=yes\n"
"--vsock cid.address=7"

#: virtinst/cli.py:920
msgid ""
"Configure an IOMMU device. Ex:\n"
"--iommu model=intel,driver.aw_bits=48"
msgstr ""
"ຕັ້ງຄ່າອຸປະກອນ IOMMU. ຕົວຢ່າງ:\n"
"--iommu model=intel,driver.aw_bits=48"

#: virtinst/cli.py:927
msgid ""
"Configure a nvram storage device.\n"
"It's for guest kernel to record oops/panic logs. Ex:\n"
"--pstore backend=acpi-erst,size=8"
msgstr ""
"ຕັ້ງຄ່າອຸປະກອນເກັບຂໍ້ມູນ nvram.\n"
"ໃຊ້ສຳລັບໃຫ້ kernel ຂອງເກສບັນທຶກລັອກ oops/panic. ຕົວຢ່າງ:\n"
"--pstore backend=acpi-erst,size=8"

#: virtinst/cli.py:939
msgid "Set domain <iothreads> and <iothreadids> configuration."
msgstr "ຕັ້ງຄ່າ <iothreads> ແລະ <iothreadids> ຂອງໂດເມນ."

#: virtinst/cli.py:944
msgid "Set domain seclabel configuration."
msgstr "ຕັ້ງຄ່າ seclabel ຂອງໂດເມນ."

#: virtinst/cli.py:951
msgid "Set guest to perform the S390 cryptographic key management operations."
msgstr "ຕັ້ງຄ່າໃຫ້ເກສດຳເນີນການຈັດການຄີການເຂົ້າລະຫັດ S390."

#: virtinst/cli.py:956
msgid "Tune CPU parameters for the domain process."
msgstr "ປັບແຕ່ງພາຣາມິເຕີ CPU ສຳລັບໂປຣເຊສຂອງໂດເມນ."

#: virtinst/cli.py:961
msgid "Tune NUMA policy for the domain process."
msgstr "ປັບແຕ່ງນະໂຍບາຍ NUMA ສຳລັບໂປຣເຊສຂອງໂດເມນ."

#: virtinst/cli.py:966
msgid "Tune memory policy for the domain process."
msgstr "ປັບແຕ່ງນະໂຍບາຍໜ່ວຍຄວາມຈຳສຳລັບໂປຣເຊສຂອງໂດເມນ."

#: virtinst/cli.py:971
msgid "Tune blkio policy for the domain process."
msgstr "ປັບແຕ່ງນະໂຍບາຍ blkio ສຳລັບໂປຣເຊສຂອງໂດເມນ."

#: virtinst/cli.py:979
msgid ""
"Set memory backing policy for the domain process. Ex:\n"
"--memorybacking hugepages=on"
msgstr ""
"ຕັ້ງນະໂຍບາຍ memory backing ສຳລັບໂປຣເຊສຂອງໂດເມນ. ຕົວຢ່າງ:\n"
"--memorybacking hugepages=on"

#: virtinst/cli.py:988
msgid ""
"Set domain <features> XML. Ex:\n"
"--features acpi=off\n"
"--features apic=on,apic.eoi=on"
msgstr ""
"ຕັ້ງ XML <features> ຂອງໂດເມນ. ຕົວຢ່າງ:\n"
"--features acpi=off\n"
"--features apic=on,apic.eoi=on"

#: virtinst/cli.py:998
msgid ""
"Set domain <clock> XML. Ex:\n"
"--clock offset=localtime,rtc_tickpolicy=catchup"
msgstr ""
"ຕັ້ງ XML <clock> ຂອງໂດເມນ. ຕົວຢ່າງ:\n"
"--clock offset=localtime,rtc_tickpolicy=catchup"

#: virtinst/cli.py:1002
msgid "Configure VM power management features"
msgstr "ຕັ້ງຄ່າຄຸນສົມບັດການຈັດການພະລັງງານຂອງ VM"

#: virtinst/cli.py:1006
msgid "Configure VM lifecycle management policy"
msgstr "ຕັ້ງຄ່ານະໂຍບາຍການຈັດການວົງຈອນຊີວິດຂອງ VM"

#: virtinst/cli.py:1011
msgid "Configure VM resource partitioning (cgroups)"
msgstr "ຕັ້ງຄ່າການແບ່ງສ່ວນຊັບພະຍາກອນຂອງ VM (cgroups)"

#: virtinst/cli.py:1019
msgid ""
"Configure SMBIOS System Information. Ex:\n"
"--sysinfo host\n"
"--sysinfo bios.vendor=MyVendor,bios.version=1.2.3,...\n"
msgstr ""
"ຕັ້ງຄ່າຂໍ້ມູນລະບົບ SMBIOS. ຕົວຢ່າງ:\n"
"--sysinfo host\n"
"--sysinfo bios.vendor=MyVendor,bios.version=1.2.3,...\n"

#: virtinst/cli.py:1030
msgid ""
"Pass arguments directly to the QEMU emulator. Ex:\n"
"--qemu-commandline='-display gtk,gl=on'\n"
"--qemu-commandline env=DISPLAY=:0.1"
msgstr ""
"ສົ່ງອາກິວເມນ (arguments) ໂດຍກົງໃຫ້ກັບ QEMU emulator. ຕົວຢ່າງ:\n"
"--qemu-commandline='-display gtk,gl=on'\n"
"--qemu-commandline env=DISPLAY=:0.1"

#: virtinst/cli.py:1042
msgid ""
"Configure VM launch security (e.g. SEV memory encryption). Ex:\n"
"--launchSecurity sev"
msgstr ""
"ຕັ້ງຄ່າຄວາມປອດໄພໃນການເລີ່ມ VM (ເຊັ່ນ ການເຂົ້າລະຫັດໜ່ວຍຄວາມຈຳ SEV). ຕົວຢ່າງ:\n"
"--launchSecurity sev"

#: virtinst/cli.py:1054
msgid ""
"Configure guest boot settings. Ex:\n"
"--boot hd,cdrom,menu=on\n"
"--boot init=/sbin/init (for containers)"
msgstr ""
"ຕັ້ງຄ່າການບູດຂອງເກສ. ຕົວຢ່າງ:\n"
"--boot hd,cdrom,menu=on\n"
"--boot init=/sbin/init (ສຳລັບ container)"

#: virtinst/cli.py:1065
msgid ""
"Enable user namespace for LXC container. Ex:\n"
"--idmap uid.start=0,uid.target=1000,uid.count=10"
msgstr ""
"ເປີດໃຊ້ user namespace ສຳລັບ LXC container. ຕົວຢ່າງ:\n"
"--idmap uid.start=0,uid.target=1000,uid.count=10"

#: virtinst/cli.py:1080
msgid ""
"Specify storage with various options. Ex.\n"
"--disk size=10 (new 10GiB image in default location)\n"
"--disk /my/existing/disk,cache=none\n"
"--disk device=cdrom,bus=scsi\n"
"--disk=?"
msgstr ""
"ກຳນົດບ່ອນເກັບຂໍ້ມູນດ້ວຍຕົວເລືອກຕ່າງໆ. ຕົວຢ່າງ:\n"
"--disk size=10 (ສ້າງອິມເມຈ 10GiB ໃໝ່ໃນບ່ອນເກັບຂໍ້ມູນເລີ່ມຕົ້ນ)\n"
"--disk /my/existing/disk,cache=none\n"
"--disk device=cdrom,bus=scsi\n"
"--disk=?"

#: virtinst/cli.py:1091
msgid "OS options"
msgstr "ຕົວເລືອກລະບົບປະຕິບັດການ (OS)"

#: virtinst/cli.py:1094
msgid "The OS being installed in the guest."
msgstr "ລະບົບປະຕິບັດການທີ່ກຳລັງຖືກຕິດຕັ້ງໃນເກສ."

#: virtinst/cli.py:1096
msgid "The OS installed in the guest."
msgstr "ລະບົບປະຕິບັດການທີ່ຕິດຕັ້ງຢູ່ໃນເກສ."

#: virtinst/cli.py:1099
msgid ""
"This is used for deciding optimal defaults like VirtIO.\n"
"Example values: fedora29, rhel7.0, win10, ...\n"
"Use '--osinfo list' to see a full list."
msgstr ""
"ສິ່ງນີ້ໃຊ້ເພື່ອຕັດສິນໃຈເລືອກຄ່າເລີ່ມຕົ້ນທີ່ເໝາະສົມ ເຊັ່ນ VirtIO.\n"
"ຕົວຢ່າງຄ່າ: fedora29, rhel7.0, win10, ...\n"
"ໃຊ້ '--osinfo list' ເພື່ອເບິ່ງລາຍການທັງໝົດ."

#: virtinst/cli.py:1115
msgid ""
"Perform raw XML XPath options on the final XML. Example:\n"
"--xml ./cpu/@mode=host-passthrough\n"
"--xml ./devices/disk[2]/serial=new-serial\n"
"--xml xpath.delete=./clock"
msgstr ""
"ດຳເນີນການຕົວເລືອກ XML XPath ໂດຍກົງໃສ່ XML ສຸດທ້າຍ. ຕົວຢ່າງ:\n"
"--xml ./cpu/@mode=host-passthrough\n"
"--xml ./devices/disk[2]/serial=new-serial\n"
"--xml xpath.delete=./clock"

#: virtinst/cli.py:1148
#, python-format
msgid "%(key)s must be 'yes' or 'no'"
msgstr "%(key)s ຕ້ອງເປັນ 'yes' ຫຼື 'no'"

#: virtinst/cli.py:1343
#, python-format
msgid ""
"Don't know how to match device type '%(device_type)s' property "
"'%(property_name)s'"
msgstr ""
"ບໍ່ຮູ້ວິທີຈັບຄູ່ປະເພດອຸປະກອນ '%(device_type)s' ກັບຄຸນສົມບັດ '%(property_name)s'"

#: virtinst/cli.py:1673
#, python-format
msgid "Unknown %(optionflag)s options: %(string)s"
msgstr "ບໍ່ຮູ້ຈັກຕົວເລືອກ %(optionflag)s: %(string)s"

#: virtinst/cli.py:1729 virtinst/cli.py:1760
#, python-format
msgid "Error: %(cli_flag_name)s %(options)s: %(err)s"
msgstr "ຂໍ້ຜິດພາດ: %(cli_flag_name)s %(options)s: %(err)s"

#: virtinst/cli.py:2193
msgid "No display detected. Not running virt-viewer."
msgstr "ກວດບໍ່ພົບການສະແດງຜົນ. ຈະບໍ່ລັນ virt-viewer."

#: virtinst/cli.py:2199
msgid ""
"Unable to connect to graphical console: virt-viewer not installed. Please "
"install the 'virt-viewer' package."
msgstr ""
"ບໍ່ສາມາດເຊື່ອມຕໍ່ກັບຄອນໂຊລແບບກຣາຟິກໄດ້: ຍັງບໍ່ໄດ້ຕິດຕັ້ງ virt-viewer. ກະລຸນາຕິດຕັ້ງແພັກເກດ 'virt-"
"viewer'."

#: virtinst/cli.py:2213
#, python-format
msgid "Unknown autoconsole type '%s'"
msgstr "ບໍ່ຮູ້ຈັກປະເພດ autoconsole '%s'"

#: virtinst/cli.py:2615
msgid "CPU model=host is deprecated, use model=host-model"
msgstr "CPU model=host ເຊົາໃຊ້ແລ້ວ, ກະລຸນາໃຊ້ model=host-model ແທນ"

#: virtinst/cli.py:3914
#, python-format
msgid "Improper value for 'size': %s"
msgstr "ຄ່າສຳລັບ 'size' ບໍ່ຖືກຕ້ອງ: %s"

#: virtinst/cli.py:3928
#, python-format
msgid "Unknown '%(optionname)s' value '%(string)s'"
msgstr "ບໍ່ຮູ້ຈັກຄ່າ '%(string)s' ສຳລັບ '%(optionname)s'"

#: virtinst/cli.py:3944
msgid "Storage volume must be specified as vol=poolname/volname"
msgstr "ຕ້ອງກຳນົດ storage volume ໃນຮູບແບບ vol=poolname/volname"

#: virtinst/cli.py:4470
#, python-format
msgid "Expected PCI format string for '%s'"
msgstr "ຕ້ອງການຂໍ້ຄວາມຮູບແບບ PCI ສຳລັບ '%s'"

#: virtinst/cli.py:5229
#, python-format
msgid "%s corresponds to multiple node devices"
msgstr "%s ກົງກັບອຸປະກອນໂນດ (node devices) ຫຼາຍອັນ"

#: virtinst/cli.py:5231
#, python-format
msgid "Did not find a matching node device for '%s'"
msgstr "ບໍ່ພົບອຸປະກອນໂນດທີ່ກົງກັບ '%s'"

#: virtinst/cli.py:5378
msgid ""
"You can see additional information with:\n"
"\n"
"  osinfo-query os\n"
msgstr ""
"ທ່ານສາມາດເບິ່ງຂໍ້ມູນເພີ່ມເຕີມໄດ້ດ້ວຍຄຳສັ່ງ:\n"
"\n"
"  osinfo-query os\n"

#: virtinst/cloner.py:46
#, python-format
msgid "Could not remove old vm '%(vm)s': %(error)s"
msgstr "ບໍ່ສາມາດລຶບ VM ເກົ່າ '%(vm)s': %(error)s"

#: virtinst/cloner.py:111
#, python-format
msgid "Domain '%s' was not found."
msgstr "ບໍ່ພົບໂດເມນ '%s'."

#: virtinst/cloner.py:161
#, python-format
msgid "Clone onto existing storage volume is not currently supported: '%s'"
msgstr ""
"ການໂຄນ (clone) ລົງໃສ່ storage volume ທີ່ມີຢູ່ແລ້ວແມ່ນຍັງບໍ່ຮອງຮັບໃນຕອນນີ້: '%s'"

#: virtinst/cloner.py:182
#, python-format
msgid "Disk path '%s' does not exist."
msgstr "ເສັ້ນທາງດິສກ໌ '%s' ບໍ່ມີຢູ່."

#: virtinst/cloner.py:191
msgid "Cloning rbd volumes is not yet supported."
msgstr "ການໂຄນ rbd volumes ແມ່ນຍັງບໍ່ຮອງຮັບ."

#: virtinst/cloner.py:194
#, python-format
msgid "Disk network type '%s' is not cloneable."
msgstr "ດິສກ໌ປະເພດເຄືອຂ່າຍ '%s' ບໍ່ສາມາດໂຄນໄດ້."

#: virtinst/cloner.py:201
msgid "Read Only"
msgstr "ອ່ານຢ່າງດຽວ"

#: virtinst/cloner.py:203
msgid "Marked as shareable"
msgstr "ໝາຍໄວ້ວ່າແບ່ງປັນໄດ້"

#: virtinst/cloner.py:277
#, python-format
msgid "Could not use path '%(path)s' for cloning: %(error)s"
msgstr "ບໍ່ສາມາດໃຊ້ເສັ້ນທາງ '%(path)s' ສຳລັບການໂຄນ: %(error)s"

#: virtinst/cloner.py:297
#, python-format
msgid "Could not determine original disk information: %s"
msgstr "ບໍ່ສາມາດລະບຸຂໍ້ມູນດິສກ໌ຕົ້ນສະບັບໄດ້: %s"

#: virtinst/cloner.py:350
msgid "Domain to clone must be shutoff."
msgstr "ໂດເມນທີ່ຈະໂຄນຕ້ອງຖືກປິດຢູ່."

#: virtinst/cloner.py:385
msgid ""
"Setting the graphics device port to autoport, in order to avoid conflicting."
msgstr ""
"ກຳລັງຕັ້ງຄ່າພອດຂອງອຸປະກອນກຣາຟິກເປັນ autoport ເພື່ອຫຼີກລ່ຽງການຂັດແຍ່ງກັນ."

#: virtinst/cloner.py:545
#, python-format
msgid "Invalid name for new guest: %s"
msgstr "ຊື່ຂອງເກສໃໝ່ບໍ່ຖືກຕ້ອງ: %s"

#: virtinst/devices/disk.py:394
#, python-format
msgid "Size must be specified for non existent volume '%s'"
msgstr "ຕ້ອງກຳນົດຂະໜາດສຳລັບ volume '%s' ທີ່ຍັງບໍ່ມີຢູ່"

#: virtinst/devices/disk.py:400
#, python-format
msgid ""
"Don't know how to create storage for path '%s'. Use libvirt APIs to manage "
"the parent directory as a pool first."
msgstr ""
