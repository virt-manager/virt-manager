"Host does not support domain type %(domain)s with machine '%(machine)s' for "
"virtualization type '%(virttype)s' with architecture '%(arch)s'"
msgstr ""
"المضيف لا يدعم نوع النطاق %(domain)s مع الآلة '%(machine)s' لنوع المحاكاة "
"'%(virttype)s' للمعمارية '%(arch)s'"

#: virtinst/capabilities.py:331
#, python-format
msgid ""
"Host does not support domain type %(domain)s for virtualization type "
"'%(virttype)s' with architecture '%(arch)s'"
msgstr ""
"المضيف لا يدعم نوع النطاق %(domain)s لنوع المحاكاة '%(virttype)s' للمعمارية "
"'%(arch)s'"

#: virtinst/cli.py:115
msgid "See man page for examples and full option syntax."
msgstr "راجع صفحة man للأمثلة والصيغة الكاملة للخيارات."

#: virtinst/cli.py:118
msgid "Use '--option=?' or '--option help' to see available suboptions"
msgstr "استخدم '--option=?' أو '--option help' لعرض الخيارات الفرعية المتاحة"

#: virtinst/cli.py:295
#, python-format
msgid ""
"Domain installation does not appear to have been successful.\n"
"If it was, you can restart your domain by running:\n"
"  %s\n"
"otherwise, please restart your installation."
msgstr ""
"يبدو أن تثبيت النطاق لم ينجح.\n"
"إذا كان قد نجح، يمكنك إعادة تشغيل النطاق بتنفيذ:\n"
"  %s\n"
"وإلا فأعد تشغيل التثبيت."

#: virtinst/cli.py:316
#, python-format
msgid ""
"%(path)s may not be accessible by the hypervisor. You will need to grant the"
" '%(user)s' user search permissions for the following directories: %(dirs)s"
msgstr ""
"قد لا يتمكن المُشرِف من الوصول إلى %(path)s. ستحتاج إلى منح المستخدم "
"'%(user)s' صلاحيات البحث في المجلدات التالية: %(dirs)s"

#: virtinst/cli.py:329
#, python-format
msgid " (Use --check %s=off or --check all=off to override)"
msgstr " (استخدم --check %s=off أو --check all=off للتجاوز)"

#: virtinst/cli.py:360
#, python-format
msgid "This will overwrite the existing path '%s'"
msgstr "سيؤدي هذا إلى الكتابة فوق المسار الموجود '%s'"

#: virtinst/cli.py:370
#, python-format
msgid "Disk %(path)s is already in use by other guests %(names)s."
msgstr "القرص %(path)s مستخدم بالفعل من ضيوف آخرين %(names)s."

#: virtinst/cli.py:414
#, python-format
msgid "Running graphical console command: %(command)s"
msgstr "جارٍ تنفيذ أمر وحدة التحكم الرسومية: %(command)s"

#: virtinst/cli.py:426
#, python-format
msgid "Running text console command: %(command)s"
msgstr "جارٍ تنفيذ أمر وحدة التحكم النصية: %(command)s"

#: virtinst/cli.py:470
#, python-format
msgid "Could not find domain '%(domain)s': %(error)s"
msgstr "تعذّر العثور على النطاق '%(domain)s': %(error)s"

#. translators: option1 and option2 are command line options,
#. e.g. -a or --disk
#: virtinst/cli.py:490
#, python-format
msgid "Cannot use %(option1)s and %(option2)s at the same time"
msgstr "لا يمكن استخدام %(option1)s و%(option2)s معاً"

#: virtinst/cli.py:608 virtinst/cli.py:612
msgid "Connect to hypervisor with libvirt URI"
msgstr "الاتصال بالمُشرِف باستخدام libvirt URI"

#: virtinst/cli.py:635
msgid ""
"Configure guest console auto connect. Example:\n"
"--autoconsole text\n"
"--autoconsole graphical\n"
"--autoconsole none"
msgstr ""
"ضبط الاتصال التلقائي بوحدة تحكم الضيف. مثال:\n"
"--autoconsole text\n"
"--autoconsole graphical\n"
"--autoconsole none"

#: virtinst/cli.py:646
msgid "Don't automatically try to connect to the guest console"
msgstr "عدم محاولة الاتصال تلقائياً بوحدة تحكم الضيف"

#: virtinst/cli.py:651
msgid "Don't boot guest after completing install."
msgstr "عدم إقلاع الضيف بعد اكتمال التثبيت."

#: virtinst/cli.py:658
msgid "Don't check name collision, overwrite any guest with the same name."
msgstr "عدم التحقق من تعارض الأسماء، والكتابة فوق أي ضيف يحمل الاسم نفسه."

#: virtinst/cli.py:665
msgid "Print the generated domain XML rather than create the guest."
msgstr "طباعة XML النطاق المُولَّد بدلاً من إنشاء الضيف."

#: virtinst/cli.py:685
msgid ""
"Run through install process, but do not create devices or define the guest."
msgstr "تنفيذ عملية التثبيت دون إنشاء الأجهزة أو تعريف الضيف."

#: virtinst/cli.py:693
msgid ""
"Enable or disable validation checks. Example:\n"
"--check path_in_use=off\n"
"--check all=off"
msgstr ""
"تفعيل فحوصات التحقق أو تعطيلها. مثال:\n"
"--check path_in_use=off\n"
"--check all=off"

#: virtinst/cli.py:698
msgid "Suppress non-error output"
msgstr "إخفاء المخرجات غير الخاصة بالأخطاء"

#: virtinst/cli.py:699
msgid "Print debugging information"
msgstr "طباعة معلومات تصحيح الأخطاء"

#: virtinst/cli.py:708
msgid ""
"Configure guest metadata. Ex:\n"
"--metadata name=foo,title=\"My pretty title\",uuid=...\n"
"--metadata description=\"My nice long description\""
msgstr ""
"ضبط البيانات الوصفية للضيف. مثال:\n"
"--metadata name=foo,title=\"My pretty title\",uuid=...\n"
"--metadata description=\"My nice long description\""

#: virtinst/cli.py:721
msgid ""
"Configure guest memory allocation. Ex:\n"
"--memory 1024 (in MiB)\n"
"--memory memory=1024,currentMemory=512\n"
msgstr ""
"ضبط تخصيص ذاكرة الضيف. مثال:\n"
"--memory 1024 (بوحدة MiB)\n"
"--memory memory=1024,currentMemory=512\n"

#: virtinst/cli.py:738
msgid ""
"Number of vCPUs to configure for your guest. Ex:\n"
"--vcpus 5\n"
"--vcpus 5,maxvcpus=10,cpuset=1-4,6,8\n"
"--vcpus sockets=2,cores=4,threads=2"
msgstr ""
"عدد المعالجات الافتراضية (vCPU) المراد ضبطها للضيف. مثال:\n"
"--vcpus 5\n"
"--vcpus 5,maxvcpus=10,cpuset=1-4,6,8\n"
"--vcpus sockets=2,cores=4,threads=2"

#: virtinst/cli.py:751
msgid ""
"CPU model and features. Ex:\n"
"--cpu coreduo,+x2apic\n"
"--cpu host-passthrough\n"
msgstr ""
"طراز المعالج وميزاته. مثال:\n"
"--cpu coreduo,+x2apic\n"
"--cpu host-passthrough\n"

#: virtinst/cli.py:766
msgid ""
"Configure guest display settings. Ex:\n"
"--graphics spice\n"
"--graphics vnc,port=5901,listen=0.0.0.0\n"
"--graphics none\n"
msgstr ""
"ضبط إعدادات شاشة الضيف. مثال:\n"
"--graphics spice\n"
"--graphics vnc,port=5901,listen=0.0.0.0\n"
"--graphics none\n"

#: virtinst/cli.py:781
msgid ""
"Configure a guest network interface. Ex:\n"
"--network bridge=mybr0\n"
"--network network=my_libvirt_virtual_net\n"
"--network network=mynet,model=virtio,mac=00:11...\n"
"--network none\n"
"--network help"
msgstr ""
"ضبط واجهة شبكة للضيف. مثال:\n"
"--network bridge=mybr0\n"
"--network network=my_libvirt_virtual_net\n"
"--network network=mynet,model=virtio,mac=00:11...\n"
"--network none\n"
"--network help"

#: virtinst/cli.py:797
msgid ""
"Configure a guest controller device. Ex:\n"
"--controller type=usb,model=qemu-xhci\n"
"--controller type=scsi,model=virtio-scsi\n"
msgstr ""
"ضبط جهاز متحكّم للضيف. مثال:\n"
"--controller type=usb,model=qemu-xhci\n"
"--controller type=scsi,model=virtio-scsi\n"

#: virtinst/cli.py:806
msgid ""
"Configure a guest input device. Ex:\n"
"--input tablet\n"
"--input keyboard,bus=usb"
msgstr ""
"ضبط جهاز إدخال للضيف. مثال:\n"
"--input tablet\n"
"--input keyboard,bus=usb"

#: virtinst/cli.py:809
msgid "Configure a guest serial device"
msgstr "ضبط جهاز تسلسلي للضيف"

#: virtinst/cli.py:811
msgid "Configure a guest parallel device"
msgstr "ضبط جهاز متوازٍ للضيف"

#: virtinst/cli.py:814
msgid "Configure a guest communication channel"
msgstr "ضبط قناة اتصال للضيف"

#: virtinst/cli.py:820
msgid "Configure a text console connection between the guest and host"
msgstr "ضبط اتصال وحدة تحكم نصية بين الضيف والمضيف"

#: virtinst/cli.py:826
msgid ""
"Configure physical USB/PCI/etc host devices to be shared with the guest"
msgstr "ضبط أجهزة USB/PCI/وغيرها الفعلية للمضيف لمشاركتها مع الضيف"

#: virtinst/cli.py:836
msgid ""
"Pass host directory to the guest. Ex: \n"
"--filesystem /my/source/dir,/dir/in/guest\n"
"--filesystem template_name,/,type=template"
msgstr ""
"تمرير مجلد من المضيف إلى الضيف. مثال: \n"
"--filesystem /my/source/dir,/dir/in/guest\n"
"--filesystem template_name,/,type=template"

#: virtinst/cli.py:846
msgid "Configure guest sound device emulation"
msgstr "ضبط محاكاة جهاز الصوت للضيف"

#: virtinst/cli.py:856
msgid "Configure host audio backend for sound devices"
msgstr "ضبط واجهة الصوت الخلفية للمضيف لأجهزة الصوت"

#: virtinst/cli.py:860
msgid "Configure a guest watchdog device"
msgstr "ضبط جهاز مراقبة (watchdog) للضيف"

#: virtinst/cli.py:862
msgid "Configure guest video hardware."
msgstr "ضبط عتاد الفيديو للضيف."

#: virtinst/cli.py:867
msgid ""
"Configure a guest smartcard device. Ex:\n"
"--smartcard mode=passthrough"
msgstr ""
"ضبط جهاز بطاقة ذكية للضيف. مثال:\n"
"--smartcard mode=passthrough"

#: virtinst/cli.py:874
msgid ""
"Configure a guest redirection device. Ex:\n"
"--redirdev usb,type=tcp,server=192.168.1.1:4000"
msgstr ""
"ضبط جهاز إعادة توجيه للضيف. مثال:\n"
"--redirdev usb,type=tcp,server=192.168.1.1:4000"

#: virtinst/cli.py:882
msgid ""
"Configure a guest memballoon device. Ex:\n"
"--memballoon model=virtio"
msgstr ""
"ضبط جهاز memballoon للضيف. مثال:\n"
"--memballoon model=virtio"

#: virtinst/cli.py:886
msgid ""
"Configure a guest TPM device. Ex:\n"
"--tpm /dev/tpm"
msgstr ""
"ضبط جهاز TPM للضيف. مثال:\n"
"--tpm /dev/tpm"

#: virtinst/cli.py:890
msgid ""
"Configure a guest RNG device. Ex:\n"
"--rng /dev/urandom"
msgstr ""
"ضبط جهاز RNG للضيف. مثال:\n"
"--rng /dev/urandom"

#: virtinst/cli.py:896
msgid ""
"Configure a guest panic device. Ex:\n"
"--panic default"
msgstr ""
"ضبط جهاز الذعر (panic) للضيف. مثال:\n"
"--panic default"

#: virtinst/cli.py:902
msgid ""
"Configure a guest shared memory device. Ex:\n"
"--shmem name=shmem0"
msgstr ""
"ضبط جهاز ذاكرة مشتركة للضيف. مثال:\n"
"--shmem name=shmem0"

#: virtinst/cli.py:908
msgid ""
"Configure a guest memory device. Ex:\n"
"--memdev dimm,target.size=1024"
msgstr ""
"ضبط جهاز ذاكرة للضيف. مثال:\n"
"--memdev dimm,target.size=1024"

#: virtinst/cli.py:914
msgid ""
"Configure guest vsock sockets. Ex:\n"
"--vsock cid.auto=yes\n"
"--vsock cid.address=7"
msgstr ""
"ضبط مقابس vsock للضيف. مثال:\n"
"--vsock cid.auto=yes\n"
"--vsock cid.address=7"

#: virtinst/cli.py:920
msgid ""
"Configure an IOMMU device. Ex:\n"
"--iommu model=intel,driver.aw_bits=48"
msgstr ""
"ضبط جهاز IOMMU. مثال:\n"
"--iommu model=intel,driver.aw_bits=48"

#: virtinst/cli.py:927
msgid ""
"Configure a nvram storage device.\n"
"It's for guest kernel to record oops/panic logs. Ex:\n"
"--pstore backend=acpi-erst,size=8"
msgstr ""
"ضبط جهاز تخزين nvram.\n"
"يُستخدم لتسجيل سجلات oops/panic من نواة الضيف. مثال:\n"
"--pstore backend=acpi-erst,size=8"

#: virtinst/cli.py:939
msgid "Set domain <iothreads> and <iothreadids> configuration."
msgstr "ضبط <iothreads> و<iothreadids> للنطاق."

#: virtinst/cli.py:944
msgid "Set domain seclabel configuration."
msgstr "ضبط seclabel للنطاق."

#: virtinst/cli.py:951
msgid "Set guest to perform the S390 cryptographic key management operations."
msgstr "تكليف الضيف بتنفيذ عمليات إدارة مفاتيح التشفير في S390."

#: virtinst/cli.py:956
msgid "Tune CPU parameters for the domain process."
msgstr "ضبط معاملات المعالج لعملية النطاق."

#: virtinst/cli.py:961
msgid "Tune NUMA policy for the domain process."
msgstr "ضبط سياسة NUMA لعملية النطاق."

#: virtinst/cli.py:966
msgid "Tune memory policy for the domain process."
msgstr "ضبط سياسة الذاكرة لعملية النطاق."

#: virtinst/cli.py:971
msgid "Tune blkio policy for the domain process."
msgstr "ضبط سياسة blkio لعملية النطاق."

#: virtinst/cli.py:979
msgid ""
"Set memory backing policy for the domain process. Ex:\n"
"--memorybacking hugepages=on"
msgstr ""
"ضبط سياسة دعم الذاكرة لعملية النطاق. مثال:\n"
"--memorybacking hugepages=on"

#: virtinst/cli.py:988
msgid ""
"Set domain <features> XML. Ex:\n"
"--features acpi=off\n"
"--features apic=on,apic.eoi=on"
msgstr ""
"ضبط XML <features> للنطاق. مثال:\n"
"--features acpi=off\n"
"--features apic=on,apic.eoi=on"

#: virtinst/cli.py:998
msgid ""
"Set domain <clock> XML. Ex:\n"
"--clock offset=localtime,rtc_tickpolicy=catchup"
msgstr ""
"ضبط XML <clock> للنطاق. مثال:\n"
"--clock offset=localtime,rtc_tickpolicy=catchup"

#: virtinst/cli.py:1002
msgid "Configure VM power management features"
msgstr "ضبط ميزات إدارة الطاقة للآلة الافتراضية"

#: virtinst/cli.py:1006
msgid "Configure VM lifecycle management policy"
msgstr "ضبط سياسة إدارة دورة حياة الآلة الافتراضية"

#: virtinst/cli.py:1011
msgid "Configure VM resource partitioning (cgroups)"
msgstr "ضبط تقسيم موارد الآلة الافتراضية (cgroups)"

#: virtinst/cli.py:1019
msgid ""
"Configure SMBIOS System Information. Ex:\n"
"--sysinfo host\n"
"--sysinfo bios.vendor=MyVendor,bios.version=1.2.3,...\n"
msgstr ""
"ضبط معلومات نظام SMBIOS. مثال:\n"
"--sysinfo host\n"
"--sysinfo bios.vendor=MyVendor,bios.version=1.2.3,...\n"

#: virtinst/cli.py:1030
msgid ""
"Pass arguments directly to the QEMU emulator. Ex:\n"
"--qemu-commandline='-display gtk,gl=on'\n"
"--qemu-commandline env=DISPLAY=:0.1"
msgstr ""
"تمرير وسائط مباشرةً إلى محاكي QEMU. مثال:\n"
"--qemu-commandline='-display gtk,gl=on'\n"
"--qemu-commandline env=DISPLAY=:0.1"

#: virtinst/cli.py:1042
msgid ""
"Configure VM launch security (e.g. SEV memory encryption). Ex:\n"
"--launchSecurity sev"
msgstr ""
"ضبط أمان إطلاق الآلة الافتراضية (مثل تشفير ذاكرة SEV). مثال:\n"
"--launchSecurity sev"

#: virtinst/cli.py:1054
msgid ""
"Configure guest boot settings. Ex:\n"
"--boot hd,cdrom,menu=on\n"
"--boot init=/sbin/init (for containers)"
msgstr ""
"ضبط إعدادات إقلاع الضيف. مثال:\n"
"--boot hd,cdrom,menu=on\n"
"--boot init=/sbin/init (للحاويات)"

#: virtinst/cli.py:1065
msgid ""
"Enable user namespace for LXC container. Ex:\n"
"--idmap uid.start=0,uid.target=1000,uid.count=10"
msgstr ""
"تفعيل فضاء أسماء المستخدم لحاوية LXC. مثال:\n"
"--idmap uid.start=0,uid.target=1000,uid.count=10"

#: virtinst/cli.py:1080
msgid ""
"Specify storage with various options. Ex.\n"
"--disk size=10 (new 10GiB image in default location)\n"
"--disk /my/existing/disk,cache=none\n"
"--disk device=cdrom,bus=scsi\n"
"--disk=?"
msgstr ""
"تحديد التخزين بخيارات متعددة. مثال:\n"
"--disk size=10 (صورة جديدة بحجم 10 GiB في الموقع الافتراضي)\n"
"--disk /my/existing/disk,cache=none\n"
"--disk device=cdrom,bus=scsi\n"
"--disk=?"

#: virtinst/cli.py:1091
msgid "OS options"
msgstr "خيارات نظام التشغيل"

#: virtinst/cli.py:1094
msgid "The OS being installed in the guest."
msgstr "نظام التشغيل الذي يجري تثبيته في الضيف."

#: virtinst/cli.py:1096
msgid "The OS installed in the guest."
msgstr "نظام التشغيل المثبّت في الضيف."

#: virtinst/cli.py:1099
msgid ""
"This is used for deciding optimal defaults like VirtIO.\n"
"Example values: fedora29, rhel7.0, win10, ...\n"
"Use '--osinfo list' to see a full list."
msgstr ""
"يُستخدم لاختيار أفضل الإعدادات الافتراضية مثل VirtIO.\n"
"أمثلة على القيم: fedora29، rhel7.0، win10، ...\n"
"استخدم '--osinfo list' لعرض القائمة الكاملة."

#: virtinst/cli.py:1115
msgid ""
"Perform raw XML XPath options on the final XML. Example:\n"
"--xml ./cpu/@mode=host-passthrough\n"
"--xml ./devices/disk[2]/serial=new-serial\n"
"--xml xpath.delete=./clock"
msgstr ""
"تنفيذ خيارات XPath خام على XML النهائي. مثال:\n"
"--xml ./cpu/@mode=host-passthrough\n"
"--xml ./devices/disk[2]/serial=new-serial\n"
"--xml xpath.delete=./clock"

#: virtinst/cli.py:1148
#, python-format
msgid "%(key)s must be 'yes' or 'no'"
msgstr "يجب أن تكون قيمة %(key)s هي 'yes' أو 'no'"

#: virtinst/cli.py:1343
#, python-format
msgid ""
"Don't know how to match device type '%(device_type)s' property "
"'%(property_name)s'"
msgstr ""
"لا توجد طريقة لمطابقة الخاصية '%(property_name)s' لنوع الجهاز "
"'%(device_type)s'"

#: virtinst/cli.py:1673
#, python-format
msgid "Unknown %(optionflag)s options: %(string)s"
msgstr "خيارات %(optionflag)s غير معروفة: %(string)s"

#: virtinst/cli.py:1729 virtinst/cli.py:1760
#, python-format
msgid "Error: %(cli_flag_name)s %(options)s: %(err)s"
msgstr "خطأ: %(cli_flag_name)s %(options)s: %(err)s"

#: virtinst/cli.py:2193
msgid "No display detected. Not running virt-viewer."
msgstr "لم تُكتشف شاشة. لن يُشغَّل virt-viewer."

#: virtinst/cli.py:2199
msgid ""
"Unable to connect to graphical console: virt-viewer not installed. Please "
"install the 'virt-viewer' package."
msgstr ""
"تعذّر الاتصال بوحدة التحكم الرسومية: virt-viewer غير مثبّت. يُرجى تثبيت حزمة"
" 'virt-viewer'."

#: virtinst/cli.py:2213
#, python-format
msgid "Unknown autoconsole type '%s'"
msgstr "نوع autoconsole غير معروف '%s'"

#: virtinst/cli.py:2615
msgid "CPU model=host is deprecated, use model=host-model"
msgstr "CPU model=host مهجور، استخدم model=host-model"

#: virtinst/cli.py:3914
#, python-format
msgid "Improper value for 'size': %s"
msgstr "قيمة غير صحيحة لـ 'size': %s"

#: virtinst/cli.py:3928
#, python-format
msgid "Unknown '%(optionname)s' value '%(string)s'"
msgstr "قيمة '%(string)s' غير معروفة للخيار '%(optionname)s'"

#: virtinst/cli.py:3944
msgid "Storage volume must be specified as vol=poolname/volname"
msgstr "يجب تحديد وحدة التخزين بالصيغة vol=poolname/volname"

#: virtinst/cli.py:4470
#, python-format
msgid "Expected PCI format string for '%s'"
msgstr "كان المتوقع نص بصيغة PCI لـ '%s'"

#: virtinst/cli.py:5229
#, python-format
msgid "%s corresponds to multiple node devices"
msgstr "%s يطابق عدة أجهزة عُقَد (node devices)"

#: virtinst/cli.py:5231
#, python-format
msgid "Did not find a matching node device for '%s'"
msgstr "لم يُعثر على جهاز عقدة مطابق لـ '%s'"

#: virtinst/cli.py:5378
msgid ""
"You can see additional information with:\n"
"\n"
"  osinfo-query os\n"
msgstr ""
"يمكنك الاطلاع على معلومات إضافية بتنفيذ:\n"
"\n"
"  osinfo-query os\n"

#: virtinst/cloner.py:46
#, python-format
msgid "Could not remove old vm '%(vm)s': %(error)s"
msgstr "تعذّرت إزالة الآلة الافتراضية القديمة '%(vm)s': %(error)s"

#: virtinst/cloner.py:111
#, python-format
msgid "Domain '%s' was not found."
msgstr "لم يُعثر على النطاق '%s'."

#: virtinst/cloner.py:161
